<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_bg_bottom"
        android:background="@color/base_66_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_bg"
        android:background="@drawable/bg_top_left_right_radius"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_200"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_17"
        android:textColor="@color/color_000000"
        android:gravity="center"
        android:id="@+id/tv_device_often_use"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_15"
        android:paddingBottom="@dimen/dp_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_often_use"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_bg"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_000000"
        android:id="@+id/tv_device_often_use_edit"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_15"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_edit"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_bg"/>
    <com.chinavisionary.core.weight.BaseRecyclerView
        android:id="@+id/recycler_often_use"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_80"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_device_often_use"/>
    <HorizontalScrollView
        android:id="@+id/horizontal_scroll_view_room_list"
        android:background="@color/color_white"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_240"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/llayout_room_list"
            android:paddingLeft="@dimen/dp_12"
            android:paddingRight="@dimen/dp_12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </HorizontalScrollView>
    <com.chinavisionary.core.weight.BaseRecyclerView
        android:id="@+id/recycler_room_list"
        android:background="@color/color_white"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_search_room"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:gravity="center"
        android:id="@+id/tv_tip_room_list_title"
        android:background="@color/color_line"
        android:paddingLeft="@dimen/dp_14"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/horizontal_scroll_view_room_list"
        style="@style/TitleTvStyle"/>
    <View
        android:id="@+id/view_bottom_split_line"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/dp_6"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_search_room"
        style="@style/HorizontalLineStyle"/>
    <EditText
        android:id="@+id/edt_search_room"
        android:background="@drawable/bg_room_list_search"
        android:paddingRight="@dimen/dp_14"
        android:visibility="visible"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_40"
        android:layout_marginLeft="@dimen/dp_25"
        android:layout_marginTop="@dimen/dp_10"
        android:hint="@string/hint_input_room_number_or_name"
        android:imeOptions="actionSearch"
        app:layout_constraintBottom_toTopOf="@+id/recycler_room_list"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_custom_sort"
        app:layout_constraintTop_toBottomOf="@+id/recycler_often_use"
        style="@style/MoreRentRoomSearchEdtStyle"/>
    <TextView
        android:textColorLink="@color/tab_item_select_color"
        android:gravity="center"
        android:autoLink="phone"
        android:id="@+id/tv_tip_msg"
        android:visibility="gone"
        android:layout_width="@dimen/dp_180"
        android:text="@string/title_default_chckin_tip"
        app:layout_constraintBottom_toBottomOf="@+id/horizontal_scroll_view_room_list"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/horizontal_scroll_view_room_list"
        style="@style/TvStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_retry_load_page"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tip_click_retry_load_data"
        app:layout_constraintBottom_toBottomOf="@+id/horizontal_scroll_view_room_list"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/horizontal_scroll_view_room_list"
        style="@style/BtnStoreGradRadiusStyle"/>
    <TextView
        android:textColor="@color/color_000000"
        android:gravity="center"
        android:id="@+id/tv_custom_sort"
        android:paddingLeft="@dimen/dp_12"
        android:paddingRight="@dimen/dp_12"
        android:visibility="visible"
        android:layout_height="@dimen/dp_40"
        android:text="@string/title_custom_lock_sort"
        app:layout_constraintRight_toRightOf="@+id/tv_tip_room_list_title"
        app:layout_constraintTop_toTopOf="@+id/edt_search_room"
        style="@style/TvStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
