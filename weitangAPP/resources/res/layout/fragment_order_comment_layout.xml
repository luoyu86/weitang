<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/title_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llayout_comment_score"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_back"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edt_comment_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llayout_comment_score"
        style="@style/EdtCommentStyle"/>
    <TextView
        android:id="@+id/tv_title_pic"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/title_add_pic"
        app:layout_constraintLeft_toLeftOf="@+id/edt_comment_content"
        app:layout_constraintTop_toBottomOf="@+id/edt_comment_content"
        style="@style/TvStyle"/>
    <FrameLayout
        android:id="@+id/flayout_comment_pic_content"
        android:layout_width="@dimen/dp_234"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_14"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_pic"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next"
        android:text="@string/title_submit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/BtnNextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
