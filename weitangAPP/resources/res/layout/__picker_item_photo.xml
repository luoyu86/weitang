<?xml version="1.0" encoding="utf-8"?>
<com.chinavisionary.core.photo.photopicker.widget.SquareItemLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_photo"
        android:padding="1dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>
    <View
        android:id="@+id/cover"
        android:background="@drawable/__picker_photo_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/v_selected"
        android:padding="5dp"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:src="@drawable/__picker_checkbox_bg"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
</com.chinavisionary.core.photo.photopicker.widget.SquareItemLayout>
