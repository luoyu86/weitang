<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_item_merchant_pressed"
    android:paddingBottom="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_merchant_cover"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_100"
        android:layout_marginLeft="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_1"
        android:layout_marginRight="@dimen/dp_1"
        android:src="@drawable/ic_default_image"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_corner_radius_top_left="@dimen/dp_4"
        app:riv_corner_radius_top_right="@dimen/dp_4"/>
    <com.chinavisionary.microtang.view.CustomTextView
        android:id="@+id/tv_merchant_name"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_15"
        android:layout_marginLeft="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_6"
        app:layout_constraintTop_toBottomOf="@+id/img_merchant_cover"
        style="@style/SingleLineTvStyle"/>
    <com.chinavisionary.microtang.view.CustomTextView
        android:textColor="@color/colorff0000"
        android:id="@+id/tv_merchant_score_value"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintLeft_toLeftOf="@+id/tv_merchant_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_merchant_name"
        style="@style/TvStyle"/>
    <com.chinavisionary.microtang.view.CustomTextView
        android:textColor="@color/colore757575"
        android:id="@+id/tv_merchant_comment_content"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_6"
        app:layout_constraintLeft_toLeftOf="@+id/tv_merchant_name"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_merchant_name"
        style="@style/SingleLineTvStyle"/>
    <com.nex3z.flowlayout.FlowLayout
        android:id="@+id/flow_layout_sale_tag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_6"
        app:flRowSpacing="@dimen/dp_4"
        app:layout_constraintLeft_toLeftOf="@+id/tv_merchant_name"
        app:layout_constraintRight_toRightOf="@+id/tv_merchant_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_merchant_score_value"/>
    <com.chinavisionary.microtang.view.CustomTextView
        android:textColor="@color/colore757575"
        android:id="@+id/tv_merchant_average_consume_value"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintLeft_toLeftOf="@+id/tv_merchant_name"
        app:layout_constraintTop_toBottomOf="@+id/flow_layout_sale_tag"
        style="@style/TvStyle"/>
    <com.chinavisionary.microtang.view.CustomTextView
        android:textColor="@color/colore757575"
        android:gravity="center"
        android:id="@+id/tv_month_sale_volume_value"
        android:paddingLeft="@dimen/dp_2"
        android:drawableLeft="@drawable/tv_left_black_drable"
        android:drawablePadding="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/tv_merchant_average_consume_value"
        app:layout_constraintLeft_toRightOf="@+id/tv_merchant_average_consume_value"
        style="@style/TvStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
