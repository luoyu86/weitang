<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_corers_6dp_padding_6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_8">
    <TextView
        android:id="@+id/tv_room_title"
        android:text="缘分小区78栋15楼1503"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ItemReserveContentTitleStyle"/>
    <TextView
        android:id="@+id/tv_reserve_person_title"
        android:text="预订人:"
        app:layout_constraintLeft_toLeftOf="@+id/tv_room_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_room_title"
        style="@style/ItemReserveTitleStyle"/>
    <TextView
        android:id="@+id/tv_reserve_person_value"
        android:text="Kchang244"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reserve_person_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_reserve_person_title"
        style="@style/ItemReserveValueStyle"/>
    <TextView
        android:id="@+id/tv_reserve_price_title"
        android:text="预订金:"
        app:layout_constraintLeft_toLeftOf="@+id/tv_reserve_person_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_reserve_person_title"
        style="@style/ItemReserveTitleStyle"/>
    <TextView
        android:id="@+id/tv_reserve_price_value"
        android:text="500元"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reserve_price_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_reserve_price_title"
        style="@style/ItemReserveValueStyle"/>
    <TextView
        android:id="@+id/tv_reserve_state_title"
        android:text="房间状态:"
        app:layout_constraintLeft_toLeftOf="@+id/tv_reserve_price_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_reserve_price_title"
        style="@style/ItemReserveTitleStyle"/>
    <TextView
        android:id="@+id/tv_reserve_state_value"
        android:text="已签约"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reserve_state_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_reserve_state_title"
        style="@style/ItemReserveValueStyle"/>
    <View
        android:id="@+id/view_split_line"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_reserve_state_title"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:textColor="@color/tab_item_select_color"
        android:gravity="center"
        android:id="@+id/tv_reserve_pay_state"
        android:layout_height="@dimen/dp_28"
        android:text="待支付"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line"
        style="@style/ItemReserveTitleStyle"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/tab_item_select_color"
        android:gravity="center"
        android:id="@+id/tv_pay_state_action"
        android:background="@drawable/bg_btn_commend"
        android:layout_width="@dimen/dp_70"
        android:layout_height="@dimen/dp_28"
        android:text="立即签约"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reserve_pay_state"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
