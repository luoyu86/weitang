<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_alert"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_180">
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/color000000"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_38"
        android:text="@string/title_alert_tip"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color000000"
        android:textColorLink="@color/tab_item_select_color"
        android:gravity="top|center_horizontal"
        android:autoLink="phone"
        android:id="@+id/tv_content"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_90"
        android:layout_marginTop="@dimen/dp_10"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:id="@+id/tv_split_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:id="@+id/tv_center_line"
        android:layout_height="@dimen/dp_45"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_split_line"
        style="@style/VerticalLineStyle"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/tab_item_select_color"
        android:gravity="center"
        android:id="@+id/tv_alert_cancel"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_45"
        android:layout_marginRight="@dimen/dp_1"
        android:text="@string/title_cancel"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_alert_confirm"
        app:layout_constraintTop_toBottomOf="@+id/tv_split_line"
        app:layout_constraintVertical_chainStyle="spread"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/tab_item_select_color"
        android:gravity="center"
        android:id="@+id/tv_alert_confirm"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_45"
        android:text="@string/title_confirm"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/tv_alert_cancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_split_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
