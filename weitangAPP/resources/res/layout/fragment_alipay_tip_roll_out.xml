<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_bg"
        android:background="@color/color000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textColor="@color/color_white"
        android:id="@+id/tv_alipay_account_tip"
        android:padding="@dimen/dp_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_title"
        android:text="@string/title_alipay_open_tip"
        android:lineSpacingExtra="@dimen/dp_6"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <com.chinavisionary.core.photo.photopicker.widget.TouchImageView
        android:id="@+id/img_tip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/ic_alipay_tip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
