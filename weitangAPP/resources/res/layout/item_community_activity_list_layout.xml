<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:paddingLeft="@dimen/dp_16"
    android:paddingRight="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_26"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_activity_cover"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_150"
        android:src="@drawable/ic_default"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_corner_radius="@dimen/dp_4"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/colorFE9900"
        android:id="@+id/tv_activity_lab"
        android:background="@drawable/bg_activity_lab"
        android:paddingLeft="@dimen/dp_5"
        android:paddingTop="@dimen/dp_2"
        android:paddingRight="@dimen/dp_5"
        android:paddingBottom="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_activity_title"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:ellipsize="end"
        android:id="@+id/tv_activity_title"
        android:paddingLeft="@dimen/dp_4"
        android:layout_width="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_10"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/tv_activity_lab"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_activity_cover"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color555555"
        android:id="@+id/tv_activity_time"
        android:layout_marginTop="@dimen/dp_14"
        app:layout_constraintLeft_toLeftOf="@+id/tv_activity_lab"
        app:layout_constraintTop_toBottomOf="@+id/tv_activity_title"
        style="@style/TvStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_white"
        android:id="@+id/btn_comment"
        android:background="@drawable/bg_btn_activity_join"
        android:layout_width="@dimen/dp_65"
        android:layout_height="@dimen/dp_24"
        android:text="@string/title_comment"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_time"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_activity_time"/>
    <View
        android:id="@+id/view_split_line"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dp_18"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_activity_time"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:id="@+id/tv_activity_timer"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/img_activity_cover"
        app:layout_constraintRight_toRightOf="@+id/img_activity_cover"
        style="@style/ActivityTimerTvStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
