<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/colore757575"
        android:gravity="center"
        android:id="@+id/tv_time"
        android:padding="@dimen/dp_10"
        android:layout_width="match_parent"
        android:text="2019-09-05 11:00"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_alert"
        android:padding="@dimen/dp_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_8"
        android:layout_marginRight="@dimen/dp_8"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_time">
        <com.chinavisionary.core.weight.CoreRoundedImageView
            android:id="@+id/img_msg_cover"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_120"
            android:src="@drawable/ic_default"
            android:scaleType="centerCrop"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_corner_radius="@dimen/dp_4"/>
        <TextView
            android:id="@+id/tv_title"
            android:paddingLeft="@dimen/dp_6"
            android:paddingRight="@dimen/dp_6"
            android:paddingBottom="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_12"
            android:text="微棠维修"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_msg_cover"
            style="@style/TitleTvStyle"/>
        <TextView
            android:textColor="@color/colore757575"
            android:id="@+id/tv_content"
            android:paddingLeft="@dimen/dp_6"
            android:paddingRight="@dimen/dp_6"
            android:paddingBottom="@dimen/dp_12"
            android:text="微棠维修"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/TvStyle"/>
        <TextView
            android:id="@+id/tv_badge_paint"
            android:layout_marginTop="@dimen/dp_6"
            android:layout_marginRight="@dimen/dp_6"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TvPaintStyle"/>
        <View
            android:id="@+id/view_split_line"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_content"
            style="@style/HorizontalLineStyle"/>
        <TextView
            android:textColor="@color/colore757575"
            android:id="@+id/tv_cat_details"
            android:paddingLeft="@dimen/dp_6"
            android:paddingTop="@dimen/dp_12"
            android:paddingRight="@dimen/dp_6"
            android:paddingBottom="@dimen/dp_12"
            android:layout_width="match_parent"
            android:text="@string/title_cat_details"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_split_line"
            style="@style/TvStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
