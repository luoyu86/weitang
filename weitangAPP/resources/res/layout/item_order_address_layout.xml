<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_express_title"
        android:layout_marginLeft="@dimen/dp_14"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/title_express_type"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_back"
        style="@style/TvStyle"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cb_express"
        android:checked="true"
        android:text="@string/title_express_to_home"
        android:drawablePadding="@dimen/dp_4"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_express_title"
        style="@style/BuyCartRadioStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:id="@+id/tv_express_fee"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/dp_10"
        android:text="@string/title_express_fee"
        app:layout_constraintBottom_toBottomOf="@+id/cb_express"
        app:layout_constraintLeft_toRightOf="@+id/cb_express"
        app:layout_constraintTop_toTopOf="@+id/cb_express"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/item_room_tv_price_color"
        android:id="@+id/tv_express_fee_value"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/dp_10"
        android:text="￥10"
        app:layout_constraintBottom_toBottomOf="@+id/cb_express"
        app:layout_constraintLeft_toRightOf="@+id/tv_express_fee"
        app:layout_constraintTop_toTopOf="@+id/cb_express"
        style="@style/TvStyle"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cb_self_picked"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/dp_20"
        android:text="@string/title_user_self_picked"
        android:drawablePadding="@dimen/dp_4"
        app:layout_constraintLeft_toRightOf="@+id/tv_express_fee_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_express_title"
        style="@style/BuyCartRadioStyle"/>
    <com.chinavisionary.microtang.view.ExpressAddressView
        android:id="@+id/express_address_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cb_express"/>
    <include
        android:id="@+id/self_address_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cb_express"
        layout="@layout/item_self_get_address_layout"/>
    <View
        android:id="@+id/view_express_order_address_bottom_line"
        android:layout_height="@dimen/dp_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/express_address_view"
        style="@style/HorizontalLineStyle"/>
</merge>
