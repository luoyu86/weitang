<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/color000000"
        android:gravity="center"
        android:id="@+id/tv_pay_info_title"
        android:background="@drawable/bg_edt_login_drawable"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:text="@string/title_update_photo"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:textSize="@dimen/sp_15"
        android:textColor="@color/color000000"
        android:id="@+id/btn_alert_photo"
        android:background="@drawable/bg_edt_login_drawable"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_46"
        android:text="@string/title_photo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay_info_title"/>
    <Button
        android:textSize="@dimen/sp_15"
        android:textColor="@color/color000000"
        android:id="@+id/btn_alert_camera"
        android:background="@drawable/bg_edt_login_drawable"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_46"
        android:text="@string/title_camera"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_alert_photo"/>
</androidx.constraintlayout.widget.ConstraintLayout>
