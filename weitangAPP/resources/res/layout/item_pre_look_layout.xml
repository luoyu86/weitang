<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_alert"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_6"
    android:layout_marginTop="@dimen/dp_12"
    android:layout_marginRight="@dimen/dp_6">
    <TextView
        android:id="@+id/tv_look_room"
        android:layout_marginLeft="@dimen/dp_12"
        android:text="@string/title_pre_look_room_no"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_look_time"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/title_subscribe_time"
        app:layout_constraintLeft_toLeftOf="@+id/tv_look_room"
        app:layout_constraintTop_toBottomOf="@+id/tv_look_room"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_look_room_value"
        android:layout_marginRight="@dimen/dp_12"
        android:text="@string/title_pre_look_room_no"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_look_time_value"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/title_subscribe_time"
        app:layout_constraintLeft_toLeftOf="@+id/tv_look_room_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_look_room_value"
        style="@style/TvStyle"/>
    <View
        android:id="@+id/view_split_line"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_look_time"
        style="@style/HorizontalLineStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_comment"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_16"
        android:text="@string/title_comment"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line"
        style="@style/BtnStoreRadiusStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
