<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/title_layout"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/margin_top_title_height"
        android:layout_marginBottom="@dimen/dp_60">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:id="@+id/tv_product_name"
                    android:paddingTop="@dimen/dp_16"
                    android:layout_marginLeft="@dimen/dp_16"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TitleTvStyle"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:enabled="false"
                    android:id="@+id/edt_input_info"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_10"
                    android:hint="@string/hint_input_repair_info"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_product_name"
                    style="@style/TvStyle"/>
                <TextView
                    android:id="@+id/tv_repair_place"
                    android:visibility="gone"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/title_repair_place"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edt_input_info"
                    style="@style/TvStyle"/>
                <com.nex3z.flowlayout.FlowLayout
                    android:id="@+id/flow_layout_place"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    app:flChildSpacing="@dimen/dp_6"
                    app:flRowSpacing="@dimen/dp_6"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_repair_place"/>
                <View
                    android:id="@+id/view_split_line"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/flow_layout_place"
                    style="@style/HorizontalLineStyle"/>
                <TextView
                    android:id="@+id/tv_repair_info_title"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/title_repair_info"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_split_line"
                    style="@style/TvStyle"/>
                <com.nex3z.flowlayout.FlowLayout
                    android:id="@+id/flow_layout_repair_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    app:flChildSpacing="@dimen/dp_6"
                    app:flRowSpacing="@dimen/dp_6"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_repair_info_title"/>
                <View
                    android:id="@+id/view_split_line_bottom"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/flow_layout_repair_info"
                    style="@style/HorizontalLineStyle"/>
                <TextView
                    android:id="@+id/tv_repair_pic_title"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/title_repair_pic"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_split_line_bottom"
                    style="@style/TvStyle"/>
                <FrameLayout
                    android:id="@+id/flayout_nine_grid_view"
                    android:layout_width="@dimen/dp_234"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_20"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_repair_pic_title"/>
                <TextView
                    android:id="@+id/tv_address"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/title_address"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/flayout_nine_grid_view"
                    style="@style/TvStyle"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:id="@+id/tv_address_value"
                    android:layout_width="match_parent"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginRight="@dimen/dp_16"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_address"
                    app:layout_constraintTop_toBottomOf="@+id/tv_address"
                    style="@style/TvStyle"/>
                <View
                    android:id="@+id/view_split_line_address_bottom"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_address_value"
                    style="@style/HorizontalLineStyle"/>
                <TextView
                    android:id="@+id/tv_service_time"
                    android:padding="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:text="@string/title_select_time"
                    android:drawableRight="@mipmap/ic_go_auth_right_arrow"
                    app:layout_constraintTop_toBottomOf="@+id/view_split_line_address_bottom"
                    style="@style/TvStyle"/>
                <View
                    android:id="@+id/view_split_line_bottom_b"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_service_time"
                    style="@style/HorizontalLineStyle"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/color000000"
                    android:id="@+id/tv_auth_open_door"
                    android:layout_width="@dimen/dp_160"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/title_auth_open_door"
                    android:lineSpacingExtra="@dimen/dp_6"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_address"
                    app:layout_constraintTop_toBottomOf="@+id/view_split_line_bottom_b"
                    style="@style/TvStyle"/>
                <CheckBox
                    android:id="@+id/cb_auth"
                    android:padding="@dimen/dp_12"
                    android:layout_marginRight="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_auth_open_door"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_auth_open_door"
                    style="@style/PayCbStyle"/>
                <TextView
                    android:id="@+id/tv_open_door_time"
                    android:padding="@dimen/dp_16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:text="@string/title_select_auth_open_door_time"
                    android:drawableRight="@mipmap/ic_go_auth_right_arrow"
                    app:layout_constraintTop_toBottomOf="@+id/cb_auth"
                    style="@style/TvStyle"/>
                <View
                    android:id="@+id/view_split_line_bottom_a"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_open_door_time"
                    style="@style/HorizontalLineStyle"/>
                <TextView
                    android:textColor="@color/color686868"
                    android:id="@+id/tv_title_contact_mode"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/title_contact_mode"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_address"
                    app:layout_constraintTop_toBottomOf="@+id/view_split_line_bottom_a"
                    style="@style/TvStyle"/>
                <TextView
                    android:id="@+id/tv_title_contact_mode_value"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_address"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title_contact_mode"
                    style="@style/TvStyle"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color000000"
                    android:gravity="top|left"
                    android:id="@+id/edt_remark"
                    android:padding="@dimen/dp_6"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_160"
                    android:layout_margin="@dimen/dp_14"
                    android:hint="@string/hint_input_remark"
                    android:maxLength="200"
                    android:inputType="textMultiLine"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title_contact_mode_value"
                    style="@style/RoomFilterEdtStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:textColor="#37474f"
        android:id="@+id/btn_next"
        android:text="@string/title_submit_order"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/BtnNextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
