<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_split_line"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:id="@+id/tv_price_count"
        android:layout_marginTop="@dimen/dp_14"
        android:layout_marginRight="@dimen/dp_14"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_count_title"
        android:paddingRight="@dimen/dp_4"
        android:text="@string/title_count_fee"
        app:layout_constraintBottom_toBottomOf="@+id/tv_price_count"
        app:layout_constraintRight_toLeftOf="@+id/tv_price_count"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_product_count"
        android:paddingRight="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/tv_count_title"
        app:layout_constraintRight_toLeftOf="@+id/tv_count_title"
        style="@style/TvStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_confirm"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_14"
        android:text="@string/title_keep_pay"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_product_count"
        style="@style/BtnStoreRadiusStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_cancel"
        android:layout_marginRight="@dimen/dp_14"
        android:text="@string/title_cancel_pay"
        app:layout_constraintBottom_toBottomOf="@+id/btn_confirm"
        app:layout_constraintRight_toLeftOf="@+id/btn_confirm"
        style="@style/BtnStoreCancelRadiusStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
