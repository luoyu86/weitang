<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_48">
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_tab_icon"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:src="@mipmap/ic_launcher"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/tv_tab_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_title"
        android:id="@+id/tv_tab_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_room_src"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:id="@+id/tv_badge_value"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="@+id/img_tab_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvBadgeStyle"/>
    <TextView
        android:id="@+id/tv_badge_paint"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/dp_14"
        app:layout_constraintLeft_toLeftOf="@+id/img_tab_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvPaintStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
