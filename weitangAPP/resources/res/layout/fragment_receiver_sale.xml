<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_transparent_bg"
        android:background="@color/base_66_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/dp_300"/>
    <View
        android:id="@+id/view_bg"
        android:background="@drawable/bg_item_spec"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_320"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_close"
        android:padding="@dimen/dp_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/ic_del_grad"
        app:layout_constraintRight_toRightOf="@+id/view_bg"
        app:layout_constraintTop_toTopOf="@+id/view_bg"/>
    <TextView
        android:id="@+id/tv_title"
        android:paddingTop="@dimen/dp_10"
        android:text="@string/title_sale"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_bg"
        style="@style/TvStyle"/>
    <com.chinavisionary.core.weight.BaseRecyclerView
        android:id="@+id/recycler_receive_sale"
        android:background="@color/color_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_280"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_close"/>
</androidx.constraintlayout.widget.ConstraintLayout>
