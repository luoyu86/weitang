<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_lib_bg_alert"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_144">
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/core_lib_color000000"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_38"
        android:text="@string/core_lib_title_alert_tip"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_333333"
        android:textColorHint="@color/color_text_content"
        android:id="@+id/core_lib_edt_input"
        android:background="@drawable/core_lib_edt_bg_drawable"
        android:paddingLeft="@dimen/dp_12"
        android:paddingRight="@dimen/dp_12"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        android:hint="@string/core_lib_hint_input_content"
        android:maxLines="2"
        android:maxLength="10"
        android:textCursorDrawable="@drawable/bg_text_cursor_drawable"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:id="@+id/tv_split_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/core_lib_edt_input"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:id="@+id/tv_center_line"
        android:layout_height="@dimen/dp_45"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_split_line"
        style="@style/VerticalLineStyle"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/core_lib_colorff9900"
        android:gravity="center"
        android:id="@+id/tv_alert_cancel"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_45"
        android:layout_marginRight="@dimen/dp_1"
        android:text="@string/core_lib_title_cancel"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_alert_confirm"
        app:layout_constraintTop_toBottomOf="@+id/tv_split_line"
        app:layout_constraintVertical_chainStyle="spread"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/core_lib_colorff9900"
        android:gravity="center"
        android:id="@+id/tv_alert_confirm"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_45"
        android:text="@string/core_lib_title_confirm"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/tv_alert_cancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_split_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
