<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/view_bottom_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/margin_top_title_height"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
                <com.chinavisionary.core.weight.banner.AutoScrollViewPager
                    android:id="@+id/banner_room_pic"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_250"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llayout_room_indicator"
                    android:background="@drawable/bg_room_details_indicator"
                    android:paddingLeft="@dimen/dp_2"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_28"
                    android:layout_marginBottom="@dimen/dp_10"
                    app:layout_constraintBottom_toBottomOf="@+id/banner_room_pic"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>
                <TextView
                    android:id="@+id/tv_product_title"
                    android:layout_marginLeft="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_15"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/banner_room_pic"
                    style="@style/TvStyle"/>
                <TextView
                    android:textSize="@dimen/sp_23"
                    android:textColor="@color/colorFE9900"
                    android:id="@+id/tv_room_price"
                    android:layout_marginTop="@dimen/dp_5"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_product_title"
                    app:layout_constraintTop_toBottomOf="@+id/tv_product_title"
                    style="@style/PayPriceStyle"/>
                <TextView
                    android:textSize="@dimen/sp_11"
                    android:textColor="@color/colorFE9900"
                    android:id="@+id/tv_room_rent_price_end"
                    android:paddingLeft="@dimen/dp_4"
                    android:paddingBottom="@dimen/dp_5"
                    android:text="@string/title_rmb_start"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_room_price"
                    app:layout_constraintLeft_toRightOf="@+id/tv_room_price"
                    style="@style/TvStyle"/>
                <View
                    android:id="@+id/view_top_split_line"
                    android:visibility="gone"
                    android:layout_marginLeft="@dimen/dp_15"
                    android:layout_marginTop="@dimen/sp_18"
                    android:layout_marginRight="@dimen/dp_15"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_room_price"
                    style="@style/HorizontalLineStyle"/>
                <com.nex3z.flowlayout.FlowLayout
                    android:id="@+id/flayout_product_tags"
                    android:paddingLeft="@dimen/dp_15"
                    android:paddingRight="@dimen/dp_15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_8"
                    app:flChildSpacing="@dimen/dp_6"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_product_title"
                    app:layout_constraintTop_toBottomOf="@+id/view_top_split_line"/>
                <View
                    android:id="@+id/view_split_line"
                    android:visibility="gone"
                    android:layout_height="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/flayout_product_tags"
                    style="@style/HorizontalLineStyle"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:id="@+id/tv_room_location_title"
                    android:paddingTop="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_8"
                    android:visibility="gone"
                    android:text="@string/title_room_location_title"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_product_title"
                    app:layout_constraintTop_toBottomOf="@+id/view_split_line"
                    style="@style/TitleTvStyle"/>
                <TextView
                    android:textSize="@dimen/sp_11"
                    android:textColor="@color/colorFE9900"
                    android:gravity="center"
                    android:id="@+id/tv_cat_community_details"
                    android:background="@drawable/bg_item_rent_room_btn"
                    android:paddingTop="@dimen/dp_4"
                    android:paddingBottom="@dimen/dp_4"
                    android:layout_height="@dimen/dp_24"
                    android:layout_marginRight="@dimen/dp_15"
                    android:text="@string/title_cat_community_details_arrow"
                    android:paddingStart="@dimen/dp_10"
                    android:paddingEnd="@dimen/dp_10"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_product_title"
                    style="@style/TvStyle"/>
                <com.chinavisionary.core.weight.CoreRoundedImageView
                    android:id="@+id/img_room_location"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_55"
                    android:layout_marginLeft="@dimen/dp_15"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginRight="@dimen/dp_15"
                    android:src="@mipmap/ic_room_location_bg"
                    android:scaleType="fitXY"
                    app:layout_constraintTop_toBottomOf="@+id/flayout_product_tags"/>
                <TextView
                    android:textColor="@color/color555555"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_room_details_location"
                    android:paddingLeft="@dimen/dp_10"
                    android:layout_width="@dimen/dp_0"
                    android:layout_marginRight="@dimen/dp_10"
                    android:maxLines="2"
                    android:drawablePadding="@dimen/dp_6"
                    app:layout_constraintBottom_toBottomOf="@+id/img_room_location"
                    app:layout_constraintLeft_toLeftOf="@+id/img_room_location"
                    app:layout_constraintRight_toLeftOf="@+id/img_room_source_location"
                    app:layout_constraintTop_toTopOf="@+id/img_room_location"
                    style="@style/TvStyle"/>
                <ImageView
                    android:id="@+id/img_room_source_location"
                    android:visibility="invisible"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_10"
                    android:src="@mipmap/ic_room_location_right_icon"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_cat_map"
                    app:layout_constraintRight_toRightOf="@+id/tv_cat_map"
                    app:layout_constraintTop_toTopOf="@+id/img_room_location"/>
                <TextView
                    android:textSize="@dimen/sp_10"
                    android:textColor="@color/color8F8F8F"
                    android:id="@+id/tv_cat_map"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp_20"
                    android:text="@string/title_cat_map"
                    app:layout_constraintRight_toRightOf="@+id/img_room_location"
                    app:layout_constraintTop_toBottomOf="@+id/img_room_source_location"/>
                <View
                    android:id="@+id/view_split_bottom_line"
                    android:visibility="gone"
                    android:layout_height="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_18"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_room_details_location"
                    style="@style/HorizontalLineStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_split_bottom_line"
                app:tabMode="scrollable"
                style="@style/MyTablayoutstyle"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_page_room"
            android:background="@color/color_white"
            android:paddingTop="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <include layout="@layout/title_layout"/>
    <ImageView
        android:id="@+id/img_finish"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_36"
        android:layout_marginLeft="@dimen/dp_25"
        android:layout_marginTop="@dimen/dp_36"
        android:src="@mipmap/ic_room_details_back"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_bottom_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/BottomViewBgStyle"/>
    <Button
        android:id="@+id/btn_pre_look_room"
        android:text="@string/title_pre_look_room"
        app:layout_constraintBottom_toBottomOf="@+id/view_bottom_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_bottom_bg"
        style="@style/BottomBtnStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
