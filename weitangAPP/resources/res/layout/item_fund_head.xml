<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorF8F8F8"
    android:paddingLeft="@dimen/dp_15"
    android:paddingTop="@dimen/dp_15"
    android:paddingRight="@dimen/dp_15"
    android:paddingBottom="@dimen/dp_15"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_30"
        android:textStyle="bold"
        android:textColor="@color/color444"
        android:id="@+id/tv_fund_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_me_fund"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color9A9A9A"
        android:id="@+id/tv_fund_account_info"
        android:paddingTop="@dimen/dp_6"
        android:paddingBottom="@dimen/dp_15"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_fund_account_info"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_fund_title"/>
    <View
        android:id="@+id/view_fund_bg"
        android:background="@drawable/bg_fund_white_radius_4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_170"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_fund_account_info"/>
    <View
        android:id="@+id/view_fund_two_bg"
        android:background="@drawable/bg_fund_two_radius_4"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginRight="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/view_fund_bg"
        app:layout_constraintLeft_toLeftOf="@+id/view_fund_bg"
        app:layout_constraintRight_toRightOf="@+id/view_fund_bg"
        app:layout_constraintTop_toTopOf="@+id/view_fund_bg"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color444"
        android:id="@+id/tv_fund_sz_title"
        android:paddingTop="@dimen/dp_15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:text="@string/title_sz_fund"
        app:layout_constraintLeft_toLeftOf="@+id/view_fund_two_bg"
        app:layout_constraintTop_toTopOf="@+id/view_fund_two_bg"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color9A9A9A"
        android:id="@+id/tv_fund_sz_account_info"
        android:paddingTop="@dimen/dp_3"
        android:paddingBottom="@dimen/dp_15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_fund_account_info"
        app:layout_constraintLeft_toLeftOf="@+id/tv_fund_sz_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_fund_sz_title"/>
    <Button
        android:id="@+id/btn_cat_fund_account"
        android:background="@drawable/bg_btn_cat_fund_account"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_40"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginRight="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_20"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="@+id/view_fund_two_bg"
        app:layout_constraintLeft_toLeftOf="@+id/view_fund_two_bg"
        app:layout_constraintRight_toRightOf="@+id/view_fund_two_bg"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/tv_query_account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_account_query"
        android:drawableLeft="@mipmap/ic_search_white"
        android:drawablePadding="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/btn_cat_fund_account"
        app:layout_constraintLeft_toLeftOf="@+id/btn_cat_fund_account"
        app:layout_constraintRight_toRightOf="@+id/btn_cat_fund_account"
        app:layout_constraintTop_toTopOf="@+id/btn_cat_fund_account"/>
    <com.chinavisionary.core.weight.banner.EditBannerView
        android:id="@+id/banner_fund"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_15"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_fund_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
