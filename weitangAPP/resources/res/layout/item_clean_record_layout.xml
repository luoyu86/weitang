<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_msg"
    android:paddingBottom="@dimen/dp_19"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_14"
    android:layout_marginRight="@dimen/dp_14">
    <TextView
        android:id="@+id/tv_title"
        android:text="@string/title_normal_clean"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RecordTitleTvStyle"/>
    <TextView
        android:id="@+id/tv_state_name"
        android:text="已完成"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RecordTitleValueTvStyle"/>
    <TextView
        android:id="@+id/tv_split_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:id="@+id/tv_order_title"
        android:text="@string/title_order_no"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_split_line"
        style="@style/CleanRecordTitleTvStyle"/>
    <TextView
        android:id="@+id/tv_create_time_title"
        android:text="@string/title_create_time"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_title"
        style="@style/CleanRecordTitleTvStyle"/>
    <TextView
        android:id="@+id/tv_server_time_title"
        android:text="@string/title_server_time"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_create_time_title"
        style="@style/CleanRecordTitleTvStyle"/>
    <TextView
        android:id="@+id/tv_surplus_time_title"
        android:visibility="gone"
        android:text="@string/title_surplus_time"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_server_time_title"
        style="@style/CleanRecordTitleTvStyle"/>
    <TextView
        android:id="@+id/tv_order_value"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_split_line"
        style="@style/CleanRecordValueTvStyle"/>
    <TextView
        android:id="@+id/tv_create_time_value"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_title"
        style="@style/CleanRecordValueTvStyle"/>
    <TextView
        android:id="@+id/tv_server_time_value"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_create_time_title"
        style="@style/CleanRecordValueTvStyle"/>
    <com.chinavisionary.microtang.clean.view.TimerTextView
        android:id="@+id/tv_surplus_time_value"
        android:visibility="gone"
        android:text="@string/title_surplus_time"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_server_time_title"
        style="@style/CleanRecordValueTvStyle"/>
    <Button
        android:id="@+id/btn_cancel_order"
        android:visibility="visible"
        android:layout_marginTop="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_server_time_value"
        style="@style/CleanCancelBtnStyle"/>
    <Button
        android:id="@+id/btn_pay"
        android:visibility="gone"
        android:layout_marginRight="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_surplus_time_value"
        style="@style/CleanPayBtnStyle"/>
    <Button
        android:id="@+id/btn_cancel_pay"
        android:visibility="gone"
        android:layout_marginRight="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/btn_pay"
        app:layout_constraintTop_toTopOf="@+id/btn_pay"
        style="@style/CleanCancelBtnStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
