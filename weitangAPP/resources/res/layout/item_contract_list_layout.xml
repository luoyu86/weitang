<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_alert"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_8"
    android:layout_marginTop="@dimen/dp_8"
    android:layout_marginRight="@dimen/dp_8">
    <TextView
        android:textSize="@dimen/sp_14"
        android:id="@+id/tv_room_name"
        android:paddingRight="@dimen/dp_26"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TitleTvStyle"/>
    <TextView
        android:textColor="@color/colore757575"
        android:id="@+id/tv_contract_no_title"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_contract_no"
        app:layout_constraintLeft_toLeftOf="@+id/tv_room_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_room_name"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_contract_no"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp_80"
        app:layout_constraintLeft_toRightOf="@+id/tv_contract_no_title"
        app:layout_constraintTop_toTopOf="@+id/tv_contract_no_title"
        style="@style/TvStyle"/>
    <TextView
        android:textColor="@color/colore757575"
        android:id="@+id/tv_month_rent"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_month_rent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_room_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_contract_no"
        style="@style/TvStyle"/>
    <TextView
        android:textColor="@color/item_room_tv_price_color"
        android:id="@+id/tv_month_rent_value"
        app:layout_constraintLeft_toLeftOf="@+id/tv_contract_no"
        app:layout_constraintTop_toTopOf="@+id/tv_month_rent"
        style="@style/TvStyle"/>
    <TextView
        android:textColor="@color/colore757575"
        android:id="@+id/tv_first_pay_title"
        android:layout_marginLeft="@dimen/dp_40"
        android:text="@string/title_first_pay_rent"
        app:layout_constraintLeft_toRightOf="@+id/tv_month_rent_value"
        app:layout_constraintTop_toTopOf="@+id/tv_month_rent"
        style="@style/TvStyle"/>
    <TextView
        android:textColor="@color/item_room_tv_price_color"
        android:id="@+id/tv_first_pay_value"
        android:layout_marginLeft="@dimen/dp_10"
        app:layout_constraintLeft_toRightOf="@+id/tv_first_pay_title"
        app:layout_constraintTop_toTopOf="@+id/tv_month_rent"
        style="@style/TvStyle"/>
    <TextView
        android:textColor="@color/colore757575"
        android:id="@+id/tv_room_rent_time_title"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_contract_time"
        app:layout_constraintLeft_toLeftOf="@+id/tv_room_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_month_rent"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_contract_time_value"
        android:text="2019-08-28至2020-08-27"
        app:layout_constraintLeft_toLeftOf="@+id/tv_contract_no"
        app:layout_constraintTop_toTopOf="@+id/tv_room_rent_time_title"
        style="@style/TvStyle"/>
    <View
        android:id="@+id/view_split_line"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_room_rent_time_title"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:textColor="@color/tab_item_select_color"
        android:id="@+id/tv_pay_state"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="@+id/tv_room_name"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/colore757575"
        android:id="@+id/tv_pay_countdown"
        android:layout_marginLeft="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_pay_state"
        app:layout_constraintLeft_toRightOf="@+id/tv_pay_state"
        app:layout_constraintTop_toTopOf="@+id/tv_pay_state"
        style="@style/TvStyle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_pay_state"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_pay_state">
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/sp_12"
            android:id="@+id/btn_action"
            android:paddingLeft="@dimen/dp_6"
            android:paddingRight="@dimen/dp_6"
            android:layout_marginRight="@dimen/dp_14"
            android:text="@string/title_pay_first_rent"
            style="@style/BtnStoreRadiusStyle"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/sp_12"
            android:id="@+id/btn_rent_change"
            android:paddingLeft="@dimen/dp_6"
            android:paddingRight="@dimen/dp_6"
            android:visibility="gone"
            android:layout_width="@dimen/dp_70"
            android:layout_marginRight="@dimen/dp_10"
            android:text="@string/title_rent_change"
            style="@style/BtnStoreGradRadiusStyle"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/sp_12"
            android:id="@+id/btn_change_rent"
            android:paddingLeft="@dimen/dp_6"
            android:paddingRight="@dimen/dp_6"
            android:visibility="gone"
            android:layout_width="@dimen/dp_70"
            android:layout_marginRight="@dimen/dp_10"
            android:text="@string/title_request_change_rent"
            style="@style/BtnKeepRentStyle"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/sp_12"
            android:id="@+id/btn_keep_rent"
            android:paddingLeft="@dimen/dp_6"
            android:paddingRight="@dimen/dp_6"
            android:visibility="visible"
            android:layout_width="@dimen/dp_70"
            android:layout_marginRight="@dimen/dp_10"
            android:text="@string/title_keep_rent"
            style="@style/BtnKeepRentStyle"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
