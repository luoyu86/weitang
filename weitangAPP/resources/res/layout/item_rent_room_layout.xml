<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_item_rent_room"
    android:paddingTop="@dimen/dp_10"
    android:paddingBottom="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_65"
    android:layout_marginBottom="@dimen/dp_10"
    android:paddingStart="@dimen/dp_15"
    android:paddingEnd="@dimen/dp_15">
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_000000"
        android:id="@+id/tv_room_no"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RentInfoTvStyle"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color999999"
        android:gravity="center"
        android:id="@+id/tv_cat_room_source_details"
        android:text="@string/title_room_source_details_arrow"
        android:paddingStart="@dimen/dp_12"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:id="@+id/tv_room_floor_orientation"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_6"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_room_no"
        style="@style/RentInfoTvStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:id="@+id/tv_room_comment"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_room_no"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RentInfoTvStyle"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/colorFE9900"
        android:id="@+id/tv_room_rent_price"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_room_no"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_7"
        android:textColor="@color/colorFE9900"
        android:id="@+id/tv_room_rent_price_end"
        android:paddingLeft="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_3"
        android:text="@string/title_rmb_month_unit"
        app:layout_constraintBottom_toBottomOf="@+id/tv_room_rent_price"
        app:layout_constraintLeft_toRightOf="@+id/tv_room_rent_price"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color999999"
        android:id="@+id/tv_room_rent_src_price"
        android:paddingLeft="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_room_rent_price_end"
        app:layout_constraintLeft_toRightOf="@+id/tv_room_rent_price_end"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/colorFE9900"
        android:id="@+id/tv_room_sing_or_pre"
        android:background="@drawable/bg_item_rent_room_btn"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:layout_marginRight="@dimen/dp_10"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_room_rent_price"
        app:layout_constraintRight_toLeftOf="@+id/tv_room_pre"
        style="@style/SignBtnStyle"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/color_white"
        android:id="@+id/tv_room_pre"
        android:background="@drawable/bg_item_rent_room_pre_btn"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:text="@string/title_pre_order"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_room_sing_or_pre"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/SignBtnStyle"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/color_333333"
        android:id="@+id/tv_room_sing_state"
        android:visibility="gone"
        android:layout_marginRight="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_room_rent_price"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_room_rent_price"
        style="@style/RentInfoTvStyle"/>
    <View
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/HorizontalLineStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
