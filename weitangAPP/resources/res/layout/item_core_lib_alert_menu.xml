<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_lib_bg_alert"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_146">
    <TextView
        android:gravity="center"
        android:id="@+id/tv_baidu"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:text="@string/core_lib_title_baidu_map"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_split_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_baidu"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_gd"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:text="@string/core_lib_title_gaode_map"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_split_line"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_tv_gd_split_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_gd"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/core_lib_colorff9900"
        android:gravity="center"
        android:id="@+id/tv_alert_cancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_45"
        android:layout_marginRight="@dimen/dp_1"
        android:text="@string/core_lib_title_cancel"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_gd"
        app:layout_constraintVertical_chainStyle="spread"/>
</androidx.constraintlayout.widget.ConstraintLayout>
