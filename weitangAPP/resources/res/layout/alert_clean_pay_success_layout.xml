<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_exit_rent"
        android:layout_width="@dimen/dp_90"
        android:layout_height="@dimen/dp_92"
        android:layout_marginTop="@dimen/dp_24"
        android:src="@mipmap/ic_clean_subscribe_success"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/color383838"
        android:gravity="center"
        android:id="@+id/tv_alert_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_19"
        android:layout_marginTop="@dimen/dp_26"
        android:text="@string/title_subscribe_success"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_exit_rent"/>
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/color686868"
        android:gravity="center"
        android:id="@+id/tv_alert_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_14"
        android:text="@string/title_clean_subscribe_success"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_alert_title"/>
    <Button
        android:id="@+id/btn_alert_clean_success_confirm"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_alert_content"
        style="@style/AlertConfirmBtnStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
