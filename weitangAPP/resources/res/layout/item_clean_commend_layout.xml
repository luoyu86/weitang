<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:paddingLeft="@dimen/dp_14"
    android:paddingTop="@dimen/dp_10"
    android:paddingRight="@dimen/dp_14"
    android:paddingBottom="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_user_icon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_corner_radius="@dimen/dp_20"
        style="@style/CommendUserIconStyle"/>
    <TextView
        android:id="@+id/tv_user_name"
        android:text="@string/app_name"
        app:layout_constraintLeft_toRightOf="@+id/img_user_icon"
        app:layout_constraintTop_toTopOf="@+id/img_user_icon"
        style="@style/CommendUserTvStyle"/>
    <com.hedgehog.ratingbar.RatingBar
        android:gravity="center"
        android:id="@+id/rating_bar_commend_star"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/img_user_icon"
        app:layout_constraintLeft_toLeftOf="@+id/tv_user_name"
        app:starCount="5"
        app:starEmpty="@mipmap/ic_comment_star_normal"
        app:starFill="@mipmap/ic_comment_star_sel"
        app:starImageHeight="@dimen/dp_16"
        app:starImageWidth="@dimen/dp_16"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/colore757575"
        android:id="@+id/tv_publish_time"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_12"
        android:text="2019-12-23 12:23"
        app:layout_constraintBottom_toBottomOf="@+id/tv_user_name"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/color686868"
        android:id="@+id/tv_clean_person_name"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_12"
        android:text="保洁员:张山"
        app:layout_constraintBottom_toBottomOf="@+id/rating_bar_commend_star"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color000000"
        android:textColorLink="@color/tab_item_select_color"
        android:autoLink="phone"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:lineSpacingExtra="@dimen/dp_2"
        app:layout_constraintTop_toBottomOf="@+id/img_user_icon"/>
    <com.lzy.ninegrid.NineGridView
        android:id="@+id/nine_grid_view_commend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_14"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
