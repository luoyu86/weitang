<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp_10"
    android:paddingRight="@dimen/dp_10"
    android:paddingBottom="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <EditText
        android:id="@+id/edt_comment_content"
        android:layout_marginLeft="@dimen/dp_0"
        android:layout_marginRight="@dimen/dp_0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/EdtCommentStyle"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color999999"
        android:id="@+id/tv_content_input_length"
        android:padding="@dimen/dp_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0/200"
        app:layout_constraintBottom_toBottomOf="@+id/edt_comment_content"
        app:layout_constraintRight_toRightOf="@+id/edt_comment_content"
        style="@style/TvStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
