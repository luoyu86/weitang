<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_alert"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_8"
    android:layout_marginTop="@dimen/dp_8"
    android:layout_marginRight="@dimen/dp_8">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_80"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <TextView
        android:textColor="@color/tab_item_select_color"
        android:id="@+id/tv_bill_state"
        android:paddingRight="@dimen/dp_12"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <View
        android:id="@+id/view_split_line"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:textColor="@color/colore757575"
        android:id="@+id/tv_bill_date"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_bill_date"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_bill_date_value"
        android:layout_marginLeft="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toRightOf="@+id/tv_bill_date"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line"
        style="@style/TvStyle"/>
    <TextView
        android:textColor="@color/colore757575"
        android:id="@+id/tv_pay_date"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_pay_date"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_bill_date"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_pay_date_value"
        android:layout_marginLeft="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toRightOf="@+id/tv_pay_date"
        app:layout_constraintTop_toBottomOf="@+id/tv_bill_date"
        style="@style/TvStyle"/>
    <View
        android:id="@+id/view_split_line_bottom"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay_date"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:textColor="@color/colore757575"
        android:id="@+id/tv_bill_price_title"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_bill_price"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line_bottom"
        style="@style/TvStyle"/>
    <TextView
        android:textColor="@color/item_room_tv_price_color"
        android:id="@+id/tv_bill_price_value"
        android:layout_marginLeft="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toRightOf="@+id/tv_bill_price_title"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line_bottom"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_8"
        android:textColor="@color/item_room_tv_price_color"
        android:id="@+id/tv_bill_late_price_value"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bill_price_value"
        app:layout_constraintLeft_toRightOf="@+id/tv_bill_price_value"
        style="@style/TvStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_pay"
        android:layout_marginRight="@dimen/dp_12"
        android:text="@string/title_confirm_pay"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bill_price_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_bill_price_title"
        style="@style/BtnStoreRadiusStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
