<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/title_layout"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color000000"
        android:gravity="center"
        android:id="@+id/tv_auth_open_door"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginLeft="@dimen/dp_14"
        android:text="@string/title_auth_open_door"
        android:lineSpacingExtra="@dimen/dp_6"
        app:layout_constraintLeft_toLeftOf="@+id/tv_back"
        app:layout_constraintTop_toBottomOf="@+id/tv_back"
        style="@style/TvStyle"/>
    <CheckBox
        android:id="@+id/cb_auth"
        android:paddingRight="@dimen/dp_14"
        android:layout_marginRight="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/tv_auth_open_door"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_auth_open_door"
        style="@style/PayCbStyle"/>
    <View
        android:id="@+id/view_split_line_a"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_auth_open_door"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:id="@+id/tv_open_door_start_time"
        android:paddingLeft="@dimen/dp_14"
        android:paddingTop="@dimen/dp_10"
        android:paddingRight="@dimen/dp_14"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:text="@string/title_auth_open_door_start_time"
        android:drawableRight="@mipmap/ic_go_auth_right_arrow"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line_a"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_open_door_start_time_value"
        android:paddingLeft="@dimen/dp_14"
        android:paddingRight="@dimen/dp_14"
        android:layout_width="match_parent"
        android:text="@string/title_empty"
        app:layout_constraintBottom_toBottomOf="@+id/tv_open_door_start_time"
        style="@style/TvStyle"/>
    <View
        android:id="@+id/view_split_line_b"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_open_door_start_time_value"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:id="@+id/tv_open_door_end_time"
        android:paddingLeft="@dimen/dp_14"
        android:paddingTop="@dimen/dp_10"
        android:paddingRight="@dimen/dp_14"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:text="@string/title_auth_open_door_end_time"
        android:drawableRight="@mipmap/ic_go_auth_right_arrow"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line_b"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_open_door_end_time_value"
        android:paddingLeft="@dimen/dp_14"
        android:paddingRight="@dimen/dp_14"
        android:layout_width="match_parent"
        android:text="@string/title_empty"
        app:layout_constraintBottom_toBottomOf="@+id/tv_open_door_end_time"
        style="@style/TvStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_save"
        android:text="@string/title_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/BtnNextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
