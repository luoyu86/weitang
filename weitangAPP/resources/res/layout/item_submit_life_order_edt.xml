<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_fund_white_radius_4"
    android:paddingBottom="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_15"
    android:layout_marginTop="@dimen/dp_10"
    android:layout_marginRight="@dimen/dp_15"
    android:layout_marginBottom="@dimen/dp_10">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tv_address_title"
        android:paddingLeft="@dimen/dp_16"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:drawablePadding="@dimen/dp_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="@dimen/sp_14"
        android:gravity="top|left"
        android:id="@+id/edt_remark"
        android:background="@color/color_white"
        android:paddingLeft="@dimen/dp_5"
        android:paddingTop="@dimen/dp_12"
        android:paddingRight="@dimen/dp_5"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_160"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:hint="@string/hint_input_order_remark"
        android:maxLength="200"
        android:inputType="textMultiLine"
        app:layout_constraintTop_toBottomOf="@+id/tv_address_title"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/colorB4B4B4"
        android:id="@+id/tv_input_number_tip"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_22"
        android:text="0/200"
        app:layout_constraintBottom_toBottomOf="@+id/edt_remark"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
