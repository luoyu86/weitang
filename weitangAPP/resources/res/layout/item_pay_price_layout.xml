<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/color000000"
        android:id="@+id/tv_pay_price_title"
        android:paddingLeft="@dimen/dp_14"
        android:paddingTop="@dimen/dp_16"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_32"
        android:text="@string/title_pay_price"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color686868"
        android:id="@+id/tv_pay_info"
        android:paddingLeft="@dimen/dp_14"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_11"
        android:layout_marginTop="@dimen/dp_13"
        android:text="@string/title_pay_info"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay_price_title"/>
    <ImageView
        android:id="@+id/img_pay_info_icon"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:layout_marginLeft="@dimen/dp_6"
        android:src="@mipmap/ic_pay_info_icon"
        app:layout_constraintBottom_toBottomOf="@+id/tv_pay_info"
        app:layout_constraintLeft_toRightOf="@+id/tv_pay_info"
        app:layout_constraintTop_toTopOf="@+id/tv_pay_info"/>
    <View
        android:id="@+id/view_pay_info"
        android:layout_width="@dimen/dp_100"
        android:layout_height="@dimen/dp_30"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay_price_title"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/item_room_tv_price_color"
        android:id="@+id/tv_pay_price_value"
        android:paddingTop="@dimen/dp_16"
        android:paddingRight="@dimen/dp_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_split_line"
        android:background="@color/color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_14"
        android:layout_marginTop="@dimen/dp_18"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay_info"/>
</androidx.constraintlayout.widget.ConstraintLayout>
