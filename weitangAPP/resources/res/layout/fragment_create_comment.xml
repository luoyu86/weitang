<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/title_layout"/>
    <androidx.core.widget.NestedScrollView
        android:background="@color/colorF8F8F8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_back">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_15"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_15">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/bg_fund_white_radius_4"
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llayout_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/view_split_line"
                    android:visibility="gone"
                    android:layout_height="@dimen/dp_6"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llayout_info"
                    style="@style/HorizontalLineStyle"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraint_top_layout"
                    android:background="@drawable/bg_create_comment_top"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_108"
                    android:layout_marginLeft="@dimen/dp_14"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginRight="@dimen/dp_14"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_split_line">
                    <ImageView
                        android:id="@+id/img_create_comment_top"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_14"
                        android:src="@mipmap/ic_create_rent_comment_top_icon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/colorff9900"
                        android:ellipsize="end"
                        android:id="@+id/tv_comment_top_content"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_14"
                        android:layout_marginRight="@dimen/dp_20"
                        android:maxLines="5"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/img_create_comment_top"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tv_one_key_praise_title"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_100"
                    android:layout_height="@dimen/dp_60"
                    android:layout_marginLeft="@dimen/dp_14"
                    android:text="@string/title_one_key_praise"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/constraint_top_layout"
                    style="@style/CommentTvStyle"/>
                <com.hedgehog.ratingbar.RatingBar
                    android:gravity="center"
                    android:id="@+id/rating_bar_praise"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:clickable="true"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_one_key_praise_title"
                    app:layout_constraintLeft_toRightOf="@+id/tv_one_key_praise_title"
                    app:layout_constraintTop_toTopOf="@+id/tv_one_key_praise_title"
                    app:starCount="5"
                    app:starEmpty="@mipmap/ic_activity_comment_normal"
                    app:starFill="@mipmap/ic_activity_comment_good"
                    app:starHalf="@mipmap/ic_activity_comment_good"
                    app:starImageHeight="@dimen/dp_30"
                    app:starImagePadding="@dimen/dp_6"
                    app:starImageWidth="@dimen/dp_30"/>
                <TextView
                    android:id="@+id/tv_tip_praise_level"
                    android:paddingRight="@dimen/dp_14"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_one_key_praise_title"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_one_key_praise_title"
                    style="@style/TvStyle"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/tab_item_select_color"
                    android:id="@+id/tv_tip_praise_tip"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_10"
                    android:visibility="gone"
                    android:text="@string/tip_praise_msg"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_one_key_praise_title"
                    app:layout_constraintTop_toBottomOf="@+id/rating_bar_praise"
                    style="@style/TvStyle"/>
                <View
                    android:id="@+id/view_praise_split_line"
                    android:visibility="gone"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_tip_praise_tip"
                    style="@style/HorizontalLineStyle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llayout_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_praise_split_line"/>
                <View
                    android:id="@+id/view_bottom_split_line"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llayout_score"
                    style="@style/HorizontalLineStyle"/>
                <TextView
                    android:id="@+id/tv_comment_title"
                    android:paddingTop="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_6"
                    android:layout_marginLeft="@dimen/dp_14"
                    android:text="@string/title_comment_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llayout_score"
                    style="@style/CommentTvStyle"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textColorHint="@color/colorB4B4B4"
                    android:id="@+id/edt_comment_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_comment_title"
                    style="@style/EdtCommentStyle"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color999999"
                    android:id="@+id/tv_input_max_length_tip"
                    android:padding="@dimen/dp_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/placeholder_max_length"
                    app:layout_constraintBottom_toBottomOf="@+id/edt_comment_content"
                    app:layout_constraintRight_toRightOf="@+id/edt_comment_content"/>
                <TextView
                    android:id="@+id/tv_add_pic_title"
                    android:layout_marginLeft="@dimen/dp_14"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/title_comment_pic"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edt_comment_content"
                    style="@style/CommentTvStyle"/>
                <FrameLayout
                    android:id="@+id/flayout_nine_grid_view"
                    android:layout_width="@dimen/dp_234"
                    android:layout_height="@dimen/dp_80"
                    android:layout_marginLeft="@dimen/dp_14"
                    android:layout_marginTop="@dimen/dp_10"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_add_pic_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraint_layout_recommend"
                android:background="@drawable/bg_fund_white_radius_4"
                android:paddingTop="@dimen/dp_12"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10">
                <View
                    android:id="@+id/view_top"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_10"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/HorizontalLineStyle"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/color_333333"
                    android:ellipsize="end"
                    android:id="@+id/tv_tip_recommend_msg"
                    android:paddingLeft="@dimen/dp_20"
                    android:paddingTop="@dimen/dp_3"
                    android:paddingRight="@dimen/dp_10"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/img_recommend_icon"
                    app:layout_constraintTop_toBottomOf="@+id/view_top"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/colorFE9900"
                    android:ellipsize="end"
                    android:id="@+id/tv_tip_recommend_subtitle"
                    android:paddingLeft="@dimen/dp_20"
                    android:paddingRight="@dimen/dp_10"
                    android:visibility="visible"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:maxLines="2"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/img_recommend_icon"
                    app:layout_constraintTop_toBottomOf="@+id/tv_tip_recommend_msg"/>
                <ImageView
                    android:id="@+id/img_recommend_icon"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_78"
                    android:layout_height="@dimen/dp_70"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginRight="@dimen/dp_16"
                    android:src="@mipmap/ic_comment_right_icon"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_top"/>
                <com.hedgehog.ratingbar.RatingBar
                    android:gravity="center"
                    android:id="@+id/rating_bar_recommend"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_marginTop="@dimen/dp_15"
                    android:layout_marginBottom="@dimen/dp_20"
                    app:clickable="true"
                    app:layout_constraintBottom_toTopOf="@+id/view_bottom"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_tip_recommend_subtitle"
                    app:starCount="5"
                    app:starEmpty="@mipmap/ic_comment_start_normal"
                    app:starFill="@mipmap/ic_comment_start_sel"
                    app:starImageHeight="@dimen/dp_30"
                    app:starImageWidth="@dimen/dp_30"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color555555"
                    android:id="@+id/tv_recommend_raging_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_20"
                    app:layout_constraintBottom_toBottomOf="@+id/rating_bar_recommend"
                    app:layout_constraintLeft_toRightOf="@+id/rating_bar_recommend"
                    app:layout_constraintTop_toTopOf="@+id/rating_bar_recommend"/>
                <View
                    android:id="@+id/view_bottom"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_10"
                    app:layout_constraintBottom_toBottomOf="parent"
                    style="@style/HorizontalLineStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next"
        android:background="@drawable/bg_btn_enable"
        android:visibility="gone"
        android:layout_width="@dimen/dp_60"
        android:layout_height="@dimen/dp_30"
        android:layout_marginRight="@dimen/dp_12"
        android:text="发布"
        app:layout_constraintBottom_toBottomOf="@+id/tv_back"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_back"
        style="@style/BtnNextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
