<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_user_icon"
        android:layout_width="@dimen/dp_56"
        android:layout_height="@dimen/dp_56"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:src="@mipmap/ic_default_icon"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_corner_radius="@dimen/dp_28"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/color6b4102"
        android:gravity="bottom"
        android:id="@+id/tv_user_name"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_27"
        android:layout_marginLeft="@dimen/dp_14"
        android:text="@string/title_un_login"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toRightOf="@+id/img_user_icon"
        app:layout_constraintTop_toTopOf="@+id/img_user_icon"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/color6b4102"
        android:gravity="bottom"
        android:id="@+id/tv_auth_state"
        android:paddingTop="@dimen/dp_6"
        android:paddingRight="@dimen/dp_16"
        android:layout_width="@dimen/dp_60"
        android:layout_height="@dimen/dp_20"
        android:layout_marginLeft="@dimen/dp_14"
        android:text="@string/title_go_auth"
        android:includeFontPadding="false"
        android:drawableRight="@mipmap/ic_go_auth_right_arrow"
        app:layout_constraintLeft_toRightOf="@+id/img_user_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_user_name"/>
    <View
        android:id="@+id/view_top_line"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_user_icon"
        style="@style/HorizontalLineStyle"/>
    <com.chinavisionary.microtang.view.FlowLayout
        android:gravity="center"
        android:id="@+id/flayout_function"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_top_line"
        style="@style/ItemMeHeadFlowLayoutStyle">
        <LinearLayout
            android:id="@+id/llayout_collection"
            android:visibility="gone"
            style="@style/ItemMeHeadLLayoutStyle">
            <com.chinavisionary.core.weight.CoreRoundedImageView
                android:id="@+id/img_collection"
                app:riv_corner_radius="@dimen/dp_8"
                style="@style/ItemMeHeadFunctionImgStyle"/>
            <TextView
                android:id="@+id/tv_collection"
                android:text="@string/title_collection"
                style="@style/ItemMeHeadFunctionTvStyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llayout_pre_look"
            style="@style/ItemMeHeadLLayoutStyle">
            <com.chinavisionary.core.weight.CoreRoundedImageView
                android:id="@+id/img_pre_look"
                app:riv_corner_radius="@dimen/dp_8"
                style="@style/ItemMeHeadFunctionImgStyle"/>
            <TextView
                android:id="@+id/tv_pre_look"
                android:text="@string/title_pre_look"
                style="@style/ItemMeHeadFunctionTvStyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llayout_pre_order"
            style="@style/ItemMeHeadLLayoutStyle">
            <com.chinavisionary.core.weight.CoreRoundedImageView
                android:id="@+id/img_pre_order"
                app:riv_corner_radius="@dimen/dp_8"
                style="@style/ItemMeHeadFunctionImgStyle"/>
            <TextView
                android:id="@+id/tv_pre_order"
                android:text="@string/title_pre_order"
                style="@style/ItemMeHeadFunctionTvStyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llayout_contract"
            style="@style/ItemMeHeadLLayoutStyle">
            <com.chinavisionary.core.weight.CoreRoundedImageView
                android:id="@+id/img_contract"
                app:riv_corner_radius="@dimen/dp_8"
                style="@style/ItemMeHeadFunctionImgStyle"/>
            <TextView
                android:id="@+id/tv_contract"
                android:text="@string/title_contact"
                style="@style/ItemMeHeadFunctionTvStyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llayout_comment"
            android:layout_marginRight="@dimen/dp_0"
            style="@style/ItemMeHeadLLayoutStyle">
            <com.chinavisionary.core.weight.CoreRoundedImageView
                android:id="@+id/img_comment"
                app:riv_corner_radius="@dimen/dp_8"
                style="@style/ItemMeHeadFunctionImgStyle"/>
            <TextView
                android:id="@+id/tv_comment"
                android:text="@string/title_comment"
                style="@style/ItemMeHeadFunctionTvStyle"/>
        </LinearLayout>
    </com.chinavisionary.microtang.view.FlowLayout>
    <View
        android:id="@+id/view_function_bottom_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flayout_function"
        style="@style/HorizontalLineStyle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llayout_wait_pay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_function_bottom_line">
        <include
            android:id="@+id/layout_me_reserve"
            layout="@layout/item_me_reserve"/>
        <include
            android:id="@+id/item_me_contract"
            layout="@layout/item_me_contract"/>
        <include
            android:id="@+id/item_me_room_info"
            layout="@layout/item_me_room_info"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
