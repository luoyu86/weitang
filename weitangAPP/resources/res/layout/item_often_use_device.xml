<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_item_lock"
    android:paddingLeft="@dimen/dp_10"
    android:paddingRight="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_50"
    android:layout_marginLeft="@dimen/dp_10"
    android:layout_marginRight="@dimen/dp_10"
    android:layout_marginBottom="@dimen/dp_10">
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/img_door_lock_type"
        android:background="@drawable/bg_content_often_use_door_room_lock"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color4297FC"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_room_simple_name"
        android:paddingLeft="@dimen/dp_10"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/img_door_lock_type"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/color000000"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/tv_room_location"
        android:paddingLeft="@dimen/dp_10"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_2"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/img_door_lock_type"
        app:layout_constraintRight_toLeftOf="@+id/cb_often"
        app:layout_constraintTop_toBottomOf="@+id/tv_room_simple_name"/>
    <ImageView
        android:id="@+id/img_room_low_battery"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/ic_low_battery_red"
        app:layout_constraintLeft_toLeftOf="@+id/img_door_lock_type"
        app:layout_constraintRight_toRightOf="@+id/img_door_lock_type"
        app:layout_constraintTop_toTopOf="@+id/img_door_lock_type"/>
    <CheckBox
        android:id="@+id/cb_often"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PayCbStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
