<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llayout_question"
        android:background="@drawable/bg_question_msg"
        android:padding="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <EditText
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color383838"
            android:id="@+id/edt_question_info"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_title_question_info"
            android:lineSpacingExtra="@dimen/dp_2"
            android:textCursorDrawable="@drawable/edt_cursor_drawable"/>
        <com.chinavisionary.core.weight.BaseRecyclerView
            android:id="@+id/nine_grid_view_commend"
            android:layout_width="@dimen/dp_234"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
