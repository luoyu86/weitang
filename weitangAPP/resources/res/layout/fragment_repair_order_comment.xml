<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/title_layout"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/margin_top_title_height"
        android:layout_marginBottom="@dimen/dp_46">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_product_satisfied"
                    android:layout_width="@dimen/dp_100"
                    android:layout_height="@dimen/dp_46"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:text="@string/title_handler_result"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TvStyle"/>
                <CheckBox
                    android:id="@+id/cb_un_over"
                    android:paddingLeft="@dimen/dp_8"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:text="@string/title_un_over"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_product_satisfied"
                    app:layout_constraintLeft_toRightOf="@+id/cb_over"
                    app:layout_constraintTop_toTopOf="@+id/tv_product_satisfied"
                    style="@style/PayCbStyle"/>
                <CheckBox
                    android:id="@+id/cb_over"
                    android:paddingLeft="@dimen/dp_8"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:text="@string/title_over"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_product_satisfied"
                    app:layout_constraintLeft_toRightOf="@+id/tv_product_satisfied"
                    app:layout_constraintTop_toTopOf="@+id/tv_product_satisfied"
                    style="@style/PayCbStyle"/>
                <View
                    android:id="@+id/view_split_line"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_product_satisfied"
                    style="@style/HorizontalLineStyle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llayout_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_split_line"/>
                <View
                    android:id="@+id/view_bottom_split_line"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llayout_score"
                    style="@style/HorizontalLineStyle"/>
                <com.nex3z.flowlayout.FlowLayout
                    android:id="@+id/flow_layout_comment_tag"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingRight="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    app:flChildSpacing="@dimen/dp_6"
                    app:flRowSpacing="@dimen/dp_6"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_bottom_split_line"/>
                <TextView
                    android:id="@+id/tv_comment_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/hint_comment_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/flow_layout_comment_tag"
                    style="@style/TvStyle"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edt_comment_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_comment_title"
                    style="@style/EdtCommentStyle"/>
                <TextView
                    android:id="@+id/tv_add_pic_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/title_add_pic"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edt_comment_content"
                    style="@style/TvStyle"/>
                <FrameLayout
                    android:id="@+id/flayout_nine_grid_view"
                    android:layout_width="@dimen/dp_234"
                    android:layout_height="@dimen/dp_234"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_10"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_add_pic_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next"
        android:text="@string/title_anonymous_comment"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/BtnNextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
