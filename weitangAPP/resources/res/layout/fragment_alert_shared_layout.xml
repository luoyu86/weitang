<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/base_66_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_1"
        android:layout_marginRight="@dimen/dp_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <View
            android:id="@+id/view_bg"
            android:background="@drawable/bg_shared"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_210"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView
            android:id="@+id/img_wx"
            android:layout_width="@dimen/dp_52"
            android:layout_height="@dimen/dp_52"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_65"
            android:src="@drawable/ic_shared_wx_chart"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_bg"/>
        <TextView
            android:id="@+id/tv_wx_chart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/title_wx_chart"
            app:layout_constraintLeft_toLeftOf="@+id/img_wx"
            app:layout_constraintRight_toRightOf="@+id/img_wx"
            app:layout_constraintTop_toBottomOf="@+id/img_wx"
            style="@style/TvStyle"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:id="@+id/tv_wx_shared"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/title_shared"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TvStyle"/>
        <TextView
            android:id="@+id/tv_wx_timeline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_wx_timeline"
            app:layout_constraintBottom_toBottomOf="@+id/tv_wx_chart"
            app:layout_constraintLeft_toLeftOf="@+id/img_wx_timeline"
            app:layout_constraintRight_toRightOf="@+id/img_wx_timeline"
            style="@style/TvStyle"/>
        <ImageView
            android:id="@+id/img_wx_timeline"
            android:layout_width="@dimen/dp_52"
            android:layout_height="@dimen/dp_52"
            android:layout_marginLeft="@dimen/sp_34"
            android:layout_marginTop="@dimen/dp_65"
            android:src="@drawable/ic_shared_wx_timeline"
            app:layout_constraintLeft_toRightOf="@+id/img_wx"
            app:layout_constraintTop_toTopOf="@+id/view_bg"/>
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/core_lib_colorff9900"
            android:gravity="center"
            android:id="@+id/tv_alert_cancel"
            android:background="@color/color_white"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_45"
            android:text="@string/title_cancel_shared"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <View
            android:id="@+id/view_center_line"
            android:background="@color/color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            app:layout_constraintBottom_toTopOf="@+id/tv_alert_cancel"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
