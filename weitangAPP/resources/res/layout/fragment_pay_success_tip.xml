<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/title_layout"/>
    <ImageView
        android:id="@+id/img_logo_icon"
        android:layout_width="@dimen/dp_50"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_90"
        android:src="@mipmap/ic_pay_success"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_split_line"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:id="@+id/tv_app_name"
        android:layout_marginTop="@dimen/dp_18"
        android:text="@string/tip_pay_success"
        app:layout_constraintLeft_toLeftOf="@+id/img_logo_icon"
        app:layout_constraintRight_toRightOf="@+id/img_logo_icon"
        app:layout_constraintTop_toBottomOf="@+id/img_logo_icon"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_A7A7A7"
        android:id="@+id/tv_app_version"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/tip_buy_end"
        app:layout_constraintLeft_toLeftOf="@+id/img_logo_icon"
        app:layout_constraintRight_toRightOf="@+id/img_logo_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_name"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/colorFE9A02"
        android:gravity="center"
        android:id="@+id/tv_open_details"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_66"
        app:layout_constraintLeft_toLeftOf="@+id/img_logo_icon"
        app:layout_constraintRight_toRightOf="@+id/img_logo_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_version"
        style="@style/TvStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
