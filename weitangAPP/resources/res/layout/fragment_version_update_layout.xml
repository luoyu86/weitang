<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_bg"
        android:background="@color/base_66_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout_alert"
        android:background="@drawable/bg_alert"
        android:layout_width="@dimen/dp_267"
        android:layout_height="373dp"
        android:layout_centerInParent="true">
        <com.chinavisionary.core.weight.CoreRoundedImageView
            android:id="@+id/img_version_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/bg_version_tip"
            android:scaleType="centerCrop"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_corner_radius_top_left="@dimen/dp_4"
            app:riv_corner_radius_top_right="@dimen/dp_4"/>
        <TextView
            android:textSize="@dimen/dp_18"
            android:textColor="@color/color000000"
            android:gravity="center"
            android:id="@+id/tv_alert_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_19"
            android:layout_marginTop="@dimen/dp_6"
            android:text="@string/tip_version_update"
            android:includeFontPadding="false"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_version_bg"/>
        <ScrollView
            android:id="@+id/sv_alert_content"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_130"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_alert_title">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/colore757575"
                android:gravity="center"
                android:id="@+id/tv_alert_content"
                android:paddingLeft="@dimen/dp_6"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_6"
                android:paddingBottom="@dimen/dp_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/dp_2"/>
        </ScrollView>
        <Button
            android:id="@+id/btn_alert_confirm"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/title_update_version_confirm"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sv_alert_content"
            style="@style/AlertConfirmBtnStyle"/>
        <Button
            android:id="@+id/btn_alert_cancel"
            android:text="@string/title_not_update_version"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_alert_confirm"
            style="@style/AlertCancelBtnStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/img_exit_rent"
        android:layout_width="@dimen/dp_97"
        android:layout_height="@dimen/dp_110"
        android:layout_marginTop="-16dp"
        android:src="@mipmap/ic_update_version_rocket"
        android:layout_alignTop="@+id/constraint_layout_alert"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
