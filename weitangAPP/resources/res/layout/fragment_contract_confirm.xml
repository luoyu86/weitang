<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/clean_base_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_confirm_contract"
        android:layout_width="@dimen/dp_276"
        android:layout_height="@dimen/dp_329"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/img_contract_icon"
            android:layout_width="@dimen/dp_86"
            android:layout_height="@dimen/dp_95"
            android:layout_marginTop="@dimen/dp_20"
            android:src="@mipmap/ic_contact_success"
            android:scaleType="centerCrop"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color000000"
            android:id="@+id/tv_title_contract"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_18"
            android:layout_marginTop="@dimen/dp_26"
            android:text="@string/title_contract_effect"
            android:includeFontPadding="false"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_contract_icon"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/colore757575"
            android:textColorLink="@color/tab_item_select_color"
            android:gravity="center"
            android:autoLink="phone"
            android:id="@+id/tv_contract_tip"
            android:padding="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            android:text="@string/title_default_chckin_tip"
            android:includeFontPadding="false"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_contract"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/colore757575"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_contract_no"
            android:background="@drawable/bg_contract_confirm_contract_no"
            android:paddingLeft="@dimen/dp_12"
            android:paddingRight="@dimen/dp_12"
            android:visibility="gone"
            android:layout_width="@dimen/dp_228"
            android:layout_height="@dimen/dp_30"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/placeholder_contract_no"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="@+id/tv_contract_tip"
            app:layout_constraintRight_toRightOf="@+id/tv_contract_tip"
            app:layout_constraintTop_toBottomOf="@+id/tv_contract_tip"/>
        <Button
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_white"
            android:id="@+id/btn_confirm"
            android:background="@drawable/bg_btn_auth"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_34"
            android:layout_marginLeft="@dimen/dp_30"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginRight="@dimen/dp_30"
            android:text="@string/title_confirm"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_contract_no"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
