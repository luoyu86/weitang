<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/core_lib_bg_alert"
    android:paddingTop="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_146">
    <ImageView
        android:id="@+id/img_wx"
        android:layout_width="@dimen/dp_50"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_8"
        android:src="@drawable/ic_shared_wx_chart"
        app:layout_constraintRight_toLeftOf="@+id/view_center_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_wx_timeline"
        android:layout_width="@dimen/dp_66"
        android:layout_height="@dimen/dp_66"
        android:src="@drawable/ic_shared_wx_timeline"
        app:layout_constraintLeft_toRightOf="@+id/view_center_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/core_lib_colorff9900"
        android:gravity="center"
        android:id="@+id/tv_alert_cancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_45"
        android:text="@string/core_lib_title_cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <View
        android:id="@+id/view_center_line"
        android:layout_width="@dimen/dp_100"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
