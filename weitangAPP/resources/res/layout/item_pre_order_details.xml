<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/dp_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_room_no"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_room_no"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_room_no_value"
        android:layout_marginRight="@dimen/dp_16"
        android:text="78栋1015"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_room_no"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_month_rent"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_month_rent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_room_no"
        app:layout_constraintTop_toBottomOf="@+id/tv_room_no"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_room_month_rent"
        android:layout_marginRight="@dimen/dp_16"
        android:text="1342元"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_month_rent"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_room_state"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_state"
        app:layout_constraintLeft_toLeftOf="@+id/tv_room_no"
        app:layout_constraintTop_toBottomOf="@+id/tv_month_rent"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_room_state_value"
        android:layout_marginRight="@dimen/dp_16"
        android:text="待租"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_room_state"
        style="@style/TvStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_sign_state"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_sign_room"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_room_state"
        style="@style/BtnStoreRadiusStyle"/>
    <View
        android:id="@+id/view_split_line"
        android:layout_height="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_14"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_sign_state"
        app:layout_goneMarginTop="@dimen/dp_14"
        style="@style/HorizontalLineStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
