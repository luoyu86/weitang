<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.chinavisionary.microtang.sign.view.BaseWebView
        android:id="@+id/web_view_protocol"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_rent_back_time"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_change_rent_info"
        app:layout_constraintVertical_bias="0"/>
    <CheckBox
        android:textSize="@dimen/sp_12"
        android:gravity="center"
        android:id="@+id/cb_agree"
        android:paddingLeft="@dimen/dp_12"
        android:paddingTop="@dimen/dp_6"
        android:paddingBottom="@dimen/dp_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/guide_line_center"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/PayCbStyle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <Button
            android:id="@+id/btn_keep_rent_date"
            android:layout_width="0dp"
            android:text="@string/title_keep_src_cycle_time"
            android:layout_weight="1"
            style="@style/BtnNextStyle"/>
        <Button
            android:id="@+id/btn_new_rent"
            android:background="@color/color_blue_link"
            android:layout_width="0dp"
            android:text="@string/title_change_rent_new_contract"
            android:layout_weight="1"
            style="@style/BtnNextStyle"/>
    </LinearLayout>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_change_rent_info"
        android:background="@color/line_color"
        android:paddingLeft="@dimen/dp_12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_38"
        android:text="@string/title_change_rent_info"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_back"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:gravity="center"
        android:id="@+id/tv_rent_back_time"
        android:background="@color/color_white"
        android:layout_width="@dimen/dp_226"
        android:layout_height="@dimen/dp_48"
        android:layout_marginLeft="@dimen/dp_30"
        android:text="@string/title_estimate_exit_rent_time"
        android:drawablePadding="@dimen/dp_4"
        app:layout_constraintBottom_toTopOf="@+id/cb_agree"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/TvStyle"/>
    <TextView
        android:textColor="@color/image_color_red"
        android:gravity="center"
        android:id="@+id/tv_rent_back_time_value"
        android:paddingRight="@dimen/dp_12"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:drawableRight="@mipmap/ic_arrow_gray"
        app:layout_constraintBottom_toTopOf="@+id/cb_agree"
        app:layout_constraintLeft_toRightOf="@+id/tv_rent_back_time"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/TvStyle"/>
    <ImageView
        android:id="@+id/img_info_tip"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_48"
        android:src="@mipmap/ic_rent_help"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/tv_rent_back_time_value"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_rent_back_time_value"/>
    <View
        android:id="@+id/guide_line_center"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_1"
        android:layout_marginBottom="@dimen/dp_50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:id="@+id/view_bottom_a_line"
        app:layout_constraintBottom_toTopOf="@+id/cb_agree"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/HorizontalLineStyle"/>
    <View
        android:id="@+id/view_bottom_b_line"
        app:layout_constraintBottom_toTopOf="@+id/tv_rent_back_time"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/HorizontalLineStyle"/>
    <include layout="@layout/core_lib_title_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
