<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_food_spec_layout"
        android:background="@color/clean_base_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout_food_spec"
        android:background="@drawable/bg_alert_grad_stroke"
        android:padding="@dimen/dp_12"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tv_food_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TvStyle"/>
        <com.chinavisionary.microtang.merchant.view.CommoditySpecLayout
            android:id="@+id/llayout_product_spec"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_240"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_food_title"/>
        <TextView
            android:textColor="@color/colore757575"
            android:gravity="center_vertical"
            android:id="@+id/tv_selected_spec_title"
            android:background="@color/color_bg"
            android:paddingLeft="@dimen/dp_4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:text="@string/title_selected_spec"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llayout_product_spec"
            style="@style/TvStyle"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_selected_spec_value"
            android:layout_height="@dimen/dp_40"
            android:layout_marginLeft="@dimen/dp_70"
            app:layout_constraintBottom_toBottomOf="@+id/tv_selected_spec_title"
            app:layout_constraintLeft_toLeftOf="@+id/tv_selected_spec_title"
            style="@style/TvStyle"/>
        <TextView
            android:textColor="@color/item_room_tv_price_color"
            android:id="@+id/tv_selected_spec_price"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_selected_spec_title"
            style="@style/TvStyle"/>
        <TextView
            android:textSize="@dimen/sp_10"
            android:gravity="center"
            android:id="@+id/tv_add_spec_buy_cart"
            android:background="@drawable/bg_food_spec_add_buy_cart"
            android:layout_height="@dimen/dp_30"
            android:layout_marginTop="@dimen/dp_6"
            android:text="@string/title_add_buy_cart"
            android:drawableLeft="@mipmap/ic_add_white"
            android:drawablePadding="@dimen/dp_4"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_selected_spec_title"
            style="@style/TvSelectSpecStyle"/>
        <com.chinavisionary.microtang.view.SpecView
            android:id="@+id/spec_food_add_reduce_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_30"
            android:layout_marginTop="@dimen/dp_6"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_selected_spec_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
