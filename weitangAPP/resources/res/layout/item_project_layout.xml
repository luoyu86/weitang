<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp_28"
    android:paddingRight="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_50">
    <TextView
        android:textSize="@dimen/sp_17"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tv_project_name"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TitleTvStyle"/>
    <ImageView
        android:id="@+id/img_project_select"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/dp_19"
        android:layout_height="@dimen/dp_0"
        android:checked="true"
        android:src="@mipmap/ic_project_select_radio_button"
        android:layout_marginEnd="@dimen/dp_18"
        app:layout_constraintBottom_toBottomOf="@+id/tv_project_name"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_project_name"/>
    <View
        android:id="@+id/view_split_line"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/colorD2D2D2"
        android:gravity="center_vertical"
        android:id="@+id/tv_community_details"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/title_community_details"
        android:drawableRight="@mipmap/ic_right_arrow_round"
        android:drawablePadding="@dimen/dp_4"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_78"
        android:layout_marginLeft="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginRight="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_4"
        app:cardCornerRadius="@dimen/dp_6"
        app:cardElevation="@dimen/dp_2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/card_view_mask"
        android:background="@drawable/bg_project_mask_select"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_78"
        android:layout_marginLeft="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginRight="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_4"
        android:translationZ="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
