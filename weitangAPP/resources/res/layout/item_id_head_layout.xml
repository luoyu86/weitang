<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_face"
        android:src="@mipmap/ic_id_card_face"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/img_back"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/IDImageStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:gravity="center"
        android:id="@+id/tv_face_title"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/title_id_card_face"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_back_title"
        app:layout_constraintTop_toBottomOf="@+id/img_face"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:gravity="center"
        android:id="@+id/tv_back_title"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/title_id_card_back"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/tv_face_title"
        app:layout_constraintRight_toLeftOf="@+id/tv_self_title"
        app:layout_constraintTop_toBottomOf="@+id/img_back"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:gravity="center"
        android:id="@+id/tv_self_title"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/title_self_photo"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/tv_back_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_self"
        style="@style/TvStyle"/>
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_back"
        android:layout_marginLeft="@dimen/dp_12"
        android:src="@mipmap/ic_id_card_back"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/img_face"
        app:layout_constraintRight_toLeftOf="@+id/img_self"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/IDImageStyle"/>
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_self"
        android:layout_marginLeft="@dimen/dp_12"
        android:src="@mipmap/ic_face"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/img_back"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/IDImageStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_upload"
        android:visibility="gone"
        android:layout_width="@dimen/dp_120"
        android:text="@string/title_upload_auth"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_back"
        style="@style/PayHydropowerBtnStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
