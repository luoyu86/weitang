<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_title"
        android:visibility="visible"
        android:layout_height="@dimen/dp_51"
        android:text="详细信息"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RoomDetailsMainTitleTvStyle"/>
    <View
        android:id="@+id/view_title_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/color000000"
        android:gravity="center_vertical"
        android:id="@+id/tv_left_title"
        android:paddingLeft="@dimen/dp_14"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_38"
        android:text="地址"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_title_line"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/colore757575"
        android:gravity="center_vertical"
        android:id="@+id/tv_right_title"
        android:paddingRight="@dimen/dp_12"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_38"
        android:text="10栋二单元5号"
        app:layout_constraintBottom_toBottomOf="@+id/tv_left_title"
        app:layout_constraintRight_toLeftOf="@+id/img_right_icon"
        app:layout_constraintTop_toTopOf="@+id/tv_left_title"/>
    <EditText
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color383838"
        android:textColorHint="@color/color686868"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/edt_user_info"
        android:background="@color/color_white"
        android:focusableInTouchMode="true"
        android:visibility="visible"
        android:layout_width="@dimen/dp_190"
        android:layout_height="@dimen/dp_38"
        android:layout_marginRight="@dimen/dp_12"
        android:hint="请输入同住人姓名"
        android:maxLines="1"
        app:layout_constraintRight_toLeftOf="@+id/img_right_icon"
        app:layout_constraintTop_toTopOf="@+id/tv_left_title"/>
    <ImageView
        android:id="@+id/img_right_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_14"
        android:src="@mipmap/ic_right_direction"
        app:layout_constraintBottom_toBottomOf="@+id/tv_left_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_left_title"/>
    <TextView
        android:id="@+id/tv_split_line"
        android:visibility="gone"
        android:layout_height="@dimen/dp_14"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_left_title"
        style="@style/HorizontalLineStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
