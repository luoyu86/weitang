<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/dp_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chinavisionary.microtang.view.ExitStateView
        android:id="@+id/state_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_user_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/state_view">
        <View
            android:id="@+id/view_split_line"
            android:layout_marginTop="@dimen/dp_20"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/HorizontalLineStyle"/>
        <com.chinavisionary.core.weight.CoreRoundedImageView
            android:id="@+id/img_user_icon"
            android:layout_marginLeft="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_20"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_split_line"
            app:riv_corner_radius="@dimen/dp_20"
            style="@style/CommendUserIconStyle"/>
        <TextView
            android:id="@+id/tv_user_name"
            android:layout_marginLeft="@dimen/dp_12"
            android:text="kchang"
            app:layout_constraintLeft_toRightOf="@+id/img_user_icon"
            app:layout_constraintTop_toTopOf="@+id/img_user_icon"
            style="@style/TvStyle"/>
        <com.hedgehog.ratingbar.RatingBar
            android:gravity="center"
            android:id="@+id/rating_bar_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:clickable="false"
            app:layout_constraintBottom_toBottomOf="@+id/img_user_icon"
            app:layout_constraintLeft_toLeftOf="@+id/tv_user_name"
            app:starCount="0"
            app:starEmpty="@mipmap/ic_comment_star_normal"
            app:starFill="@mipmap/ic_comment_star_sel"
            app:starImageHeight="@dimen/dp_16"
            app:starImageWidth="@dimen/dp_16"
            app:starNum="5"/>
        <TextView
            android:textColor="@color/colore757575"
            android:id="@+id/tv_order_number"
            android:layout_marginLeft="@dimen/dp_12"
            android:text="1230单"
            app:layout_constraintBottom_toBottomOf="@+id/rating_bar_comment"
            app:layout_constraintLeft_toRightOf="@+id/rating_bar_comment"
            style="@style/TvStyle"/>
        <ImageButton
            android:id="@+id/img_btn_phone"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_14"
            android:src="@mipmap/ic_phone"
            app:layout_constraintBottom_toBottomOf="@+id/img_user_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/img_user_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
