<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout_server"
        android:background="@drawable/bg_msg"
        android:paddingBottom="@dimen/dp_26"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_18"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color383838"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:paddingLeft="@dimen/dp_12"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:text="@string/title_question_classify"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/img_right_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_12"
            android:src="@mipmap/ic_right_direction"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color686868"
            android:gravity="center_vertical"
            android:id="@+id/tv_question_value"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:layout_marginRight="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintRight_toLeftOf="@+id/img_right_icon"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color383838"
            android:gravity="center_vertical"
            android:id="@+id/tv_common_title"
            android:paddingLeft="@dimen/dp_12"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:text="@string/title_common_question"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <ImageView
            android:id="@+id/img_question_right_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_12"
            android:src="@mipmap/ic_right_direction"
            app:layout_constraintBottom_toBottomOf="@+id/tv_common_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_common_title"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color686868"
            android:gravity="center_vertical"
            android:id="@+id/tv_common_question_value"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:layout_marginRight="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="@+id/tv_common_title"
            app:layout_constraintRight_toLeftOf="@+id/img_question_right_icon"
            app:layout_constraintTop_toTopOf="@+id/tv_common_title"/>
        <include
            android:id="@+id/include_comment_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginRight="@dimen/dp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_common_title"
            layout="@layout/fragment_commend_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/center"
        android:layout_width="@dimen/dp_1"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraint_layout_server"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/colore757575"
        android:id="@+id/tv_service_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/tip_urgent"
        app:layout_constraintRight_toLeftOf="@+id/center"
        app:layout_constraintTop_toBottomOf="@+id/constraint_layout_server"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/tab_item_select_color"
        android:textColorLink="@color/tab_item_select_color"
        android:autoLink="phone"
        android:id="@+id/tv_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="400-123-123"
        app:layout_constraintBottom_toBottomOf="@+id/tv_service_phone"
        app:layout_constraintLeft_toRightOf="@+id/center"/>
    <Button
        android:id="@+id/btn_submit"
        android:layout_marginLeft="@dimen/dp_35"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_35"
        android:text="@string/title_submit"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_service_phone"
        style="@style/SubmitBtnStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
