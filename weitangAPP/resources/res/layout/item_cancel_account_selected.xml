<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:paddingLeft="@dimen/dp_26"
    android:paddingTop="@dimen/dp_10"
    android:paddingRight="@dimen/dp_26"
    android:paddingBottom="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/cb_reason"
        android:layout_height="wrap_content"
        android:checked="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PayCbStyle"/>
    <TextView
        android:textColor="@color/color_333333"
        android:id="@+id/tv_reason"
        android:paddingTop="@dimen/dp_5"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_8"
        app:layout_constraintLeft_toRightOf="@+id/cb_reason"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cb_reason"
        style="@style/TvStyle"/>
    <EditText
        android:textSize="@dimen/sp_14"
        android:gravity="top|left"
        android:id="@+id/edt_remark"
        android:background="@drawable/bg_cancel_account_edt"
        android:padding="@dimen/dp_14"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_140"
        android:layout_marginTop="@dimen/dp_20"
        android:hint="@string/hint_cancel_account_reason"
        android:maxLength="200"
        android:inputType="textMultiLine"
        android:textCursorDrawable="@drawable/edt_cursor_drawable"
        app:layout_constraintTop_toBottomOf="@+id/tv_reason"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color999999"
        android:id="@+id/tv_input_max_length_tip"
        android:padding="@dimen/dp_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_max_length"
        app:layout_constraintBottom_toBottomOf="@+id/edt_remark"
        app:layout_constraintRight_toRightOf="@+id/edt_remark"/>
</androidx.constraintlayout.widget.ConstraintLayout>
