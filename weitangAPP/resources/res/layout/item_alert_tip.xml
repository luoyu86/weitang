<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorF8F8F8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_alert_tip"
        android:layout_width="@dimen/dp_22"
        android:layout_height="@dimen/dp_22"
        android:layout_marginLeft="@dimen/dp_14"
        android:src="@mipmap/ic_alert_icon"
        app:layout_constraintBottom_toBottomOf="@+id/tv_alert_tip_msg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_alert_tip_msg"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/colorFE4F4F"
        android:gravity="center"
        android:id="@+id/tv_alert_tip_msg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_38"
        app:layout_constraintLeft_toRightOf="@+id/img_alert_tip"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
