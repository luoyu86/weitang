<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/title_layout"/>
    <ImageView
        android:id="@+id/img_logo_icon"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_60"
        android:src="@mipmap/ic_launcher"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_split_line"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:id="@+id/tv_app_name"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/app_name"
        app:layout_constraintLeft_toLeftOf="@+id/img_logo_icon"
        app:layout_constraintRight_toRightOf="@+id/img_logo_icon"
        app:layout_constraintTop_toBottomOf="@+id/img_logo_icon"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:id="@+id/tv_app_version"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="@+id/img_logo_icon"
        app:layout_constraintRight_toRightOf="@+id/img_logo_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_name"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tv_app_icp"
        android:layout_marginTop="@dimen/dp_12"
        android:text="ICP备案: 粤ICP备19049967号-3A"
        android:drawableRight="@mipmap/ic_item_arrow_right_gray"
        app:layout_constraintLeft_toLeftOf="@+id/img_logo_icon"
        app:layout_constraintRight_toRightOf="@+id/img_logo_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_version"
        style="@style/TvStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
