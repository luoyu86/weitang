<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/title_layout"/>
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_repair_product"
        android:layout_width="@dimen/dp_60"
        android:layout_height="@dimen/dp_60"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@drawable/ic_default"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_back"/>
    <TextView
        android:id="@+id/tv_product_name"
        android:layout_marginLeft="@dimen/dp_12"
        android:text="浴霸"
        app:layout_constraintLeft_toRightOf="@+id/img_repair_product"
        app:layout_constraintTop_toTopOf="@+id/img_repair_product"
        style="@style/TitleTvStyle"/>
    <TextView
        android:id="@+id/tv_product_info"
        android:layout_marginLeft="@dimen/dp_12"
        android:text="卫生间,不制热"
        app:layout_constraintBottom_toBottomOf="@+id/img_repair_product"
        app:layout_constraintLeft_toRightOf="@+id/img_repair_product"
        style="@style/TvStyle"/>
    <View
        android:id="@+id/view_split_line"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_repair_product"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:id="@+id/tv_address"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_address"
        app:layout_constraintLeft_toLeftOf="@+id/img_repair_product"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_address_value"
        android:layout_marginTop="@dimen/dp_12"
        android:text="元芬新村,78号楼1202"
        app:layout_constraintLeft_toLeftOf="@+id/img_repair_product"
        app:layout_constraintTop_toBottomOf="@+id/tv_address"
        style="@style/TvStyle"/>
    <View
        android:id="@+id/view_split_line_bottom"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_address_value"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:id="@+id/tv_auth_open_door"
        android:layout_marginTop="@dimen/dp_12"
        android:text="不在家,授权维修师傅再约定时间段开门?"
        app:layout_constraintLeft_toLeftOf="@+id/img_repair_product"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line_bottom"
        style="@style/TvStyle"/>
    <CheckBox
        android:id="@+id/cb_auth"
        android:padding="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_auth_open_door"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_auth_open_door"
        style="@style/PayCbStyle"/>
    <View
        android:id="@+id/view_split_line_bottom_a"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_auth_open_door"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:id="@+id/tv_service_time"
        android:padding="@dimen/dp_14"
        android:layout_width="match_parent"
        android:text="2019-09-03 16:00-19:00"
        android:drawableRight="@mipmap/ic_go_auth_right_arrow"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line_bottom_a"
        style="@style/TvStyle"/>
    <View
        android:id="@+id/view_split_line_bottom_b"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_service_time"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:id="@+id/tv_title_contact_mode"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_contact_mode"
        app:layout_constraintLeft_toLeftOf="@+id/img_repair_product"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line_bottom_b"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_title_contact_mode_value"
        android:layout_marginTop="@dimen/dp_12"
        android:text="13317678383"
        app:layout_constraintLeft_toLeftOf="@+id/img_repair_product"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_contact_mode"
        style="@style/TvStyle"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/sp_14"
        android:textColor="@color/colore757575"
        android:gravity="top|left"
        android:id="@+id/edt_remark"
        android:padding="@dimen/dp_6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_160"
        android:layout_margin="@dimen/dp_14"
        android:hint="@string/hint_input_remark"
        android:maxLength="200"
        android:inputType="textMultiLine"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_contact_mode_value"
        style="@style/RoomFilterEdtStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next"
        android:text="@string/title_submit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/BtnNextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
