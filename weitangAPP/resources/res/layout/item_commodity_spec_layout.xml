<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chinavisionary.microtang.view.CustomTextView
        android:textColor="@color/colore757575"
        android:id="@+id/tv_spec_title"
        android:layout_marginTop="@dimen/sp_10"
        android:text="@string/title_select_spec"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <com.nex3z.flowlayout.FlowLayout
        android:id="@+id/flow_layout_product_spec"
        android:padding="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_spec_title"
        app:lineSpacing="@dimen/dp_4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
