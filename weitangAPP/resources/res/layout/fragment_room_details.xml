<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.chinavisionary.core.weight.BaseSwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/dp_46"/>
    <LinearLayout
        android:id="@+id/llayout_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_46"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent">
        <Button
            android:textSize="@dimen/sp_15"
            android:textColor="@color/color_white"
            android:id="@+id/btn_pre_look_room"
            android:background="@color/color0066cc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/title_pre_look_room"
            android:layout_weight="1"/>
        <Button
            android:textSize="@dimen/sp_15"
            android:textColor="@color/color_white"
            android:id="@+id/btn_sign_room"
            android:background="@color/tab_item_select_color"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/title_sign_room"
            android:layout_weight="1"/>
        <Button
            android:textSize="@dimen/sp_15"
            android:textColor="@color/color_white"
            android:id="@+id/btn_unsign_room"
            android:background="@color/colore757575"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/title_sign_room_over"/>
    </LinearLayout>
    <include layout="@layout/title_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
