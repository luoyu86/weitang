<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_common_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_title"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_dialog_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="10dp"
        android:maxLines="1"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_text_content"
        android:gravity="center"
        android:id="@+id/tv_dialog_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:minHeight="80dp"/>
    <View style="@style/HorizontalLineStyle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_text_title"
            android:gravity="center"
            android:id="@+id/tv_dialog_left_button"
            android:background="@drawable/sel_dialog_btn_bg_left"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/text_cancel"
            android:singleLine="true"
            android:layout_weight="1"/>
        <View style="@style/VerticalLineStyle"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_text_title"
            android:gravity="center"
            android:id="@+id/tv_dialog_right_button"
            android:background="@drawable/sel_dialog_btn_bg_right"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/text_confirm"
            android:singleLine="true"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
