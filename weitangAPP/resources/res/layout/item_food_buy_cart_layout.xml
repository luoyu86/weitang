<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_product_cover"
        android:layout_width="@dimen/dp_60"
        android:layout_height="@dimen/dp_60"
        android:src="@drawable/ic_default_image"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_corner_radius="@dimen/dp_4"/>
    <com.chinavisionary.microtang.view.CustomTextView
        android:textStyle="bold"
        android:ellipsize="end"
        android:id="@+id/tv_product_name"
        android:layout_marginLeft="@dimen/dp_8"
        android:singleLine="true"
        app:layout_constraintLeft_toRightOf="@+id/img_product_cover"
        app:layout_constraintTop_toTopOf="@+id/img_product_cover"
        style="@style/TvStyle"/>
    <com.chinavisionary.microtang.view.CustomTextView
        android:textSize="@dimen/sp_12"
        android:id="@+id/tv_select_spec_name"
        android:layout_marginTop="@dimen/dp_6"
        app:layout_constraintLeft_toLeftOf="@+id/tv_product_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_product_name"
        style="@style/TvStyle"/>
    <com.chinavisionary.microtang.view.CustomTextView
        android:textColor="@color/item_room_tv_price_color"
        android:gravity="center_vertical"
        android:id="@+id/tv_product_price"
        android:layout_height="@dimen/spec_layout_height"
        android:layout_marginTop="@dimen/dp_4"
        app:layout_constraintLeft_toLeftOf="@+id/tv_product_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_select_spec_name"
        style="@style/TvStyle"/>
    <com.chinavisionary.microtang.view.SpecView
        android:id="@+id/spec_view"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spec_layout_height"
        app:layout_constraintBottom_toBottomOf="@+id/tv_product_price"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
