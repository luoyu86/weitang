<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/banner_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <Button
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_white"
        android:id="@+id/banner_add_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/edt_banner_view_indicator_margin_right"
        android:layout_marginTop="@dimen/edt_banner_view_indicator_margin_right"
        android:text="@string/edit_banner_add_title"
        android:stateListAnimator="@null"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_white"
        android:id="@+id/banner_del_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/edt_banner_view_indicator_margin_right"
        android:layout_marginTop="@dimen/edt_banner_view_indicator_margin_right"
        android:text="@string/edit_banner_del_title"
        android:stateListAnimator="@null"
        app:layout_constraintLeft_toRightOf="@+id/banner_add_btn"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llayout_indicator"
        android:layout_width="match_parent"
        android:layout_height="@dimen/edt_banner_view_indicator_height"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
