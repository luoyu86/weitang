<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/color_white"
        android:paddingLeft="@dimen/dp_24"
        android:paddingTop="@dimen/dp_10"
        android:paddingRight="@dimen/dp_24"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:id="@+id/tv_icon_name"
            android:text="@string/title_user_icon"
            app:layout_constraintBottom_toBottomOf="@+id/img_user_icon"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/img_user_icon"
            style="@style/ItemEditMeHeadTextViewStyle"/>
        <com.chinavisionary.core.weight.CoreRoundedImageView
            android:id="@+id/img_user_icon"
            android:layout_width="@dimen/dp_54"
            android:layout_height="@dimen/dp_54"
            android:src="@mipmap/ic_default_icon"
            android:scaleType="centerCrop"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_corner_radius="@dimen/dp_27"/>
        <View
            android:id="@+id/view_split_line"
            android:background="@color/colorF8F8F8"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_user_icon"
            style="@style/HorizontalLineStyle"/>
        <TextView
            android:id="@+id/tv_user_nick_name"
            android:text="@string/title_nick_name"
            app:layout_constraintBottom_toBottomOf="@+id/edt_user_name"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/edt_user_name"
            style="@style/ItemEditMeHeadTextViewStyle"/>
        <TextView
            android:gravity="center"
            android:id="@+id/edt_user_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_52"
            android:maxLines="1"
            android:singleLine="true"
            android:drawableRight="@mipmap/ic_item_arrow_right_gray"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_split_line"
            style="@style/ItemEditMeHeadTextViewStyle"/>
        <View
            android:id="@+id/view_split_line_nick_name"
            android:background="@color/colorF8F8F8"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edt_user_name"
            style="@style/HorizontalLineStyle"/>
        <TextView
            android:id="@+id/tv_account_name"
            android:text="@string/title_account_name"
            app:layout_constraintBottom_toBottomOf="@+id/tv_account_value"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_account_value"
            style="@style/ItemEditMeHeadTextViewStyle"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_account_value"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_52"
            android:maxLines="1"
            android:singleLine="true"
            android:drawableRight="@mipmap/ic_item_arrow_right_gray"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_split_line_nick_name"
            style="@style/ItemEditMeHeadTextViewStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
