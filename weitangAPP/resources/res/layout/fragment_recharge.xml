<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_bg"
        android:background="@color/clean_base_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/BottomConstraintLayoutStyle">
        <TextView
            android:id="@+id/tv_bg"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BottomTitleBgTvStyle"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/tv_title"
            android:layout_marginLeft="@dimen/dp_14"
            app:layout_constraintBottom_toBottomOf="@+id/tv_bg"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_bg"
            style="@style/BottomTitleTvStyle"/>
        <TextView
            android:textColor="@color/item_room_tv_price_color"
            android:id="@+id/tv_right_value"
            android:paddingRight="@dimen/dp_12"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/tv_bg"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_bg"
            style="@style/BottomTitleTvStyle"/>
        <TextView
            android:id="@+id/tv_right_title"
            android:visibility="gone"
            android:text="@string/title_count_value"
            app:layout_constraintBottom_toBottomOf="@+id/tv_bg"
            app:layout_constraintRight_toLeftOf="@+id/tv_right_value"
            app:layout_constraintTop_toTopOf="@+id/tv_bg"
            style="@style/BottomTitleTvStyle"/>
        <HorizontalScrollView
            android:id="@+id/horizontal_scroll_view_unit"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_bg">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llayout_unit"
                android:paddingLeft="@dimen/dp_12"
                android:paddingTop="@dimen/dp_18"
                android:paddingRight="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_18"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <com.chinavisionary.core.weight.BaseRecyclerView
            android:id="@+id/recycler_recharge"
            android:paddingLeft="@dimen/dp_6"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_120"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_bg"/>
        <View
            android:id="@+id/view_bottom_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            style="@style/BottomViewBgStyle"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_pay"
            android:text="@string/title_recharge"
            app:layout_constraintBottom_toBottomOf="@+id/view_bottom_bg"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_bottom_bg"
            style="@style/BottomBtnStyle"/>
        <include
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/horizontal_scroll_view_unit"
            layout="@layout/item_untitle_wx_alipay_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
