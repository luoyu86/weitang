<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorF8F8F8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/core_lib_title_layout"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:gravity="center_vertical"
        android:id="@+id/tv_select_project_name"
        android:background="@color/color_white"
        android:paddingLeft="@dimen/dp_25"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:drawableLeft="@mipmap/ic_project_select"
        android:drawablePadding="@dimen/dp_5"
        app:layout_constraintTop_toBottomOf="@+id/tv_back"/>
    <com.chinavisionary.core.weight.BaseSwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout_city"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/dp_86"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_select_project_name"/>
    <com.chinavisionary.core.weight.BaseSwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout_project"
        android:background="@color/color_white"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/dp_0"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/swipe_refresh_layout_city"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_select_project_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
