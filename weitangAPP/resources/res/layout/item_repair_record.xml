<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_msg"
    android:paddingBottom="@dimen/dp_19"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_8"
    android:layout_marginRight="@dimen/dp_8">
    <TextView
        android:id="@+id/tv_title"
        android:text="@string/title_free_repair"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RecordTitleTvStyle"/>
    <TextView
        android:id="@+id/tv_state_name"
        android:text="已完成"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RecordTitleValueTvStyle"/>
    <TextView
        android:id="@+id/tv_split_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:id="@+id/tv_order_title"
        android:text="@string/title_order_no"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_split_line"
        style="@style/CleanRecordTitleTvStyle"/>
    <TextView
        android:id="@+id/tv_create_time_title"
        android:text="@string/title_create_time"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_title"
        style="@style/CleanRecordTitleTvStyle"/>
    <TextView
        android:id="@+id/tv_server_time_title"
        android:text="@string/title_repair_type"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_create_time_title"
        style="@style/CleanRecordTitleTvStyle"/>
    <TextView
        android:id="@+id/tv_order_value"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_split_line"
        style="@style/CleanRecordValueTvStyle"/>
    <TextView
        android:id="@+id/tv_create_time"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_title"
        style="@style/CleanRecordValueTvStyle"/>
    <TextView
        android:id="@+id/tv_repair_type"
        android:text="马桶"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_create_time"
        style="@style/CleanRecordValueTvStyle"/>
    <Button
        android:id="@+id/btn_cancel"
        android:visibility="visible"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_repair_type"
        style="@style/CleanCancelBtnStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
