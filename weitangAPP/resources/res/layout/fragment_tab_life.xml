<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorF8F8F8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="@dimen/dp_0">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_136"
                app:buttonGravity="bottom"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <com.chinavisionary.core.weight.banner.EditBannerView
                    android:id="@+id/banner_life_cover"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_265"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/view_tab_top_bg"
                    android:background="@drawable/bg_tab"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_45"
                    android:layout_marginLeft="@dimen/dp_15"
                    android:layout_marginTop="@dimen/dp_220"
                    android:layout_marginRight="@dimen/dp_15"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/view_tab_bottom_bg"
                    android:background="@drawable/bg_tab_bottom"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginLeft="@dimen/dp_15"
                    android:layout_marginRight="@dimen/dp_15"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginLeft="@dimen/dp_15"
                    android:layout_marginTop="@dimen/dp_215"
                    android:layout_marginRight="@dimen/dp_15"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tabBackground="@null"
                    app:tabGravity="fill"
                    app:tabMaxWidth="0dp"
                    app:tabMode="fixed"
                    app:tabPaddingEnd="@dimen/dp_0"
                    app:tabPaddingStart="@dimen/dp_0"
                    style="@style/MyTablayoutstyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_page_life"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <RelativeLayout
        android:id="@+id/rlayout_title"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_36"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/color000000"
            android:gravity="center"
            android:id="@+id/tv_city"
            android:paddingLeft="@dimen/dp_10"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:maxWidth="@dimen/dp_118"
            android:text="@string/app_name"
            android:drawableLeft="@mipmap/ic_project_location"
            android:drawablePadding="@dimen/dp_4"
            style="@style/CityStyle"/>
        <TextView
            android:textColor="@color/color000000"
            android:gravity="center"
            android:id="@+id/edt_input_search"
            android:visibility="invisible"
            android:layout_height="@dimen/dp_28"
            android:layout_marginLeft="@dimen/dp_6"
            android:layout_toLeftOf="@+id/rlayout_server"
            android:layout_toRightOf="@+id/tv_city"
            style="@style/MoreRentRoomSearchEdtStyle"/>
        <RelativeLayout
            android:id="@+id/rlayout_scan"
            android:layout_marginRight="@dimen/dp_11"
            android:layout_alignParentRight="true"
            style="@style/TitleIconLayoutStyle">
            <ImageView
                android:id="@+id/img_title_about"
                android:src="@mipmap/ic_scan"
                style="@style/TitleIconStyle"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rlayout_notify"
            android:layout_toLeftOf="@+id/rlayout_scan"
            style="@style/TitleIconLayoutStyle">
            <ImageView
                android:id="@+id/img_title_notify"
                android:src="@mipmap/ic_notify"
                style="@style/TitleIconStyle"/>
            <TextView
                android:id="@+id/tv_badge_value"
                android:visibility="gone"
                android:layout_marginTop="-4dp"
                android:layout_marginRight="-3dp"
                android:layout_alignTop="@+id/img_title_notify"
                android:layout_alignRight="@+id/img_title_notify"
                style="@style/TvBadgeStyle"/>
            <TextView
                android:id="@+id/tv_badge_paint"
                android:visibility="gone"
                android:layout_marginRight="-2dp"
                android:layout_alignTop="@+id/img_title_notify"
                android:layout_alignRight="@+id/img_title_notify"
                style="@style/TvPaintStyle"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rlayout_server"
            android:layout_toLeftOf="@+id/rlayout_notify"
            style="@style/TitleIconLayoutStyle">
            <ImageView
                android:id="@+id/img_title_server"
                android:src="@mipmap/ic_server"
                style="@style/TitleIconStyle"/>
        </RelativeLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
