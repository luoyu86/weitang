<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_search_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginRight="@dimen/dp_70"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_search_layout"/>
    <TextView
        android:textColor="@color/color_000000"
        android:gravity="center"
        android:id="@+id/tv_finish"
        android:paddingLeft="@dimen/dp_15"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_40"
        android:text="@string/title_cancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/include_search_layout"
        style="@style/TvStyle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_tip_msg"
        android:padding="@dimen/dp_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:text="@string/title_searching"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include_search_layout"
        style="@style/TvStyle"/>
    <com.chinavisionary.core.weight.BaseSwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout_more_rent"
        android:paddingLeft="@dimen/dp_14"
        android:paddingTop="@dimen/dp_10"
        android:paddingRight="@dimen/dp_14"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include_search_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
