<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_bg"
        android:background="@color/base_66_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout_roll_out"
        android:background="@color/color_white"
        android:paddingLeft="@dimen/dp_14"
        android:paddingRight="@dimen/dp_14"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_234"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edt_alipay_real_name"
            android:hint="@string/tip_input_alipay_name"
            android:imeOptions="actionNext"
            android:nextFocusForward="@+id/edt_account_phone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/RollOutEdtStyle"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edt_alipay_account"
            android:hint="@string/hint_input_alipay_phone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edt_alipay_real_name"
            style="@style/RollOutEdtStyle"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/colore757575"
            android:id="@+id/tv_alert_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            android:lineSpacingExtra="@dimen/dp_4"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edt_alipay_account"
            style="@style/TvStyle"/>
        <ImageView
            android:id="@+id/img_alipay_roll_out_tip"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_80"
            android:layout_marginTop="@dimen/dp_14"
            android:src="@mipmap/ic_alipay_small_tip"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_alert_tip"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/tv_title_bg"
        android:background="@color/color_bg"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintBottom_toTopOf="@+id/constraint_layout_roll_out"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/TitleTvStyle"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_title_roll_out_price"
        android:paddingLeft="@dimen/dp_14"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintBottom_toTopOf="@+id/constraint_layout_roll_out"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/TitleTvStyle"/>
    <ImageButton
        android:id="@+id/img_btn_tip"
        android:background="@null"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@mipmap/ic_help"
        app:layout_constraintLeft_toRightOf="@+id/tv_title_roll_out_price"
        app:layout_constraintTop_toTopOf="@+id/tv_title_roll_out_price"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/sp_14"
        android:textColor="@color/tab_item_select_color"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:background="@null"
        android:paddingRight="@dimen/dp_14"
        android:layout_width="@dimen/dp_90"
        android:layout_height="@dimen/dp_48"
        android:text="@string/title_confirm"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title_roll_out_price"/>
</androidx.constraintlayout.widget.ConstraintLayout>
