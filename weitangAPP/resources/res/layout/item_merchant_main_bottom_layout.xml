<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_bottom_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_12"
        android:gravity="center"
        android:id="@+id/tv_contact_merchant"
        android:background="@null"
        android:paddingTop="@dimen/dp_4"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_48"
        android:text="@string/title_contact_merchant"
        android:drawableTop="@mipmap/ic_merchant_phone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_bottom_split_line"
        style="@style/TvStyle"/>
    <TextView
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/tv_settlement"
        android:background="@color/item_room_tv_price_color"
        android:padding="@dimen/dp_8"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_48"
        android:text="@string/title_go_settlement"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_contact_merchant"
        style="@style/TvStyle"/>
    <View
        android:id="@+id/view_bottom_split_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/HorizontalLineStyle"/>
    <View
        android:id="@+id/view_bottom_bg"
        android:background="@color/tab_item_select_color"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintLeft_toRightOf="@+id/tv_contact_merchant"
        app:layout_constraintRight_toLeftOf="@+id/tv_settlement"
        app:layout_constraintTop_toTopOf="@+id/tv_contact_merchant"/>
    <ImageView
        android:id="@+id/img_bottom_buy_cart_icon"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginLeft="@dimen/dp_6"
        android:src="@mipmap/ic_buy_cart_white"
        app:layout_constraintLeft_toRightOf="@+id/tv_contact_merchant"
        app:layout_constraintTop_toTopOf="@+id/tv_contact_merchant"/>
    <TextView
        android:id="@+id/tv_buy_cart_count"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintLeft_toLeftOf="@+id/img_bottom_buy_cart_icon"
        app:layout_constraintRight_toRightOf="@+id/img_bottom_buy_cart_icon"
        app:layout_constraintTop_toTopOf="@+id/img_bottom_buy_cart_icon"
        style="@style/BadgeViewStyle"/>
    <com.chinavisionary.microtang.view.CustomTextView
        android:textColor="@color/color_white"
        android:id="@+id/tv_product_count_fee"
        android:paddingTop="@dimen/dp_4"
        android:layout_marginLeft="@dimen/dp_8"
        android:text="￥0.0"
        app:layout_constraintBottom_toBottomOf="@+id/tv_contact_merchant"
        app:layout_constraintLeft_toRightOf="@+id/img_bottom_buy_cart_icon"
        app:layout_constraintTop_toTopOf="@+id/tv_contact_merchant"
        style="@style/TvStyle"/>
    <com.chinavisionary.microtang.view.CustomTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_white"
        android:id="@+id/tv_product_express_fee"
        android:paddingTop="@dimen/dp_4"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/dp_8"
        android:text="@string/placeholder_express_fee"
        app:layout_constraintLeft_toRightOf="@+id/img_bottom_buy_cart_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_product_count_fee"
        style="@style/TvStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
