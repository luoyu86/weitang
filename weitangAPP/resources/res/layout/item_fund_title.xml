<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_fund_white_top_left_right_radius_8"
    android:paddingBottom="@dimen/dp_4"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_38"
    android:layout_marginLeft="@dimen/dp_15"
    android:layout_marginRight="@dimen/dp_15">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color444"
        android:gravity="bottom"
        android:id="@+id/tv_news_content"
        android:paddingLeft="@dimen/dp_15"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/title_about_news"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="#767676"
        android:gravity="bottom"
        android:id="@+id/tv_cat_more"
        android:paddingLeft="@dimen/dp_15"
        android:paddingTop="@dimen/dp_16"
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:text="@string/title_cat_more"
        android:drawableRight="@mipmap/ic_new_arrow_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
