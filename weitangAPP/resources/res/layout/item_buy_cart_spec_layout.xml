<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_buy_cart_spec_layout"
    android:paddingTop="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cb_product"
        android:visibility="visible"
        android:layout_height="@dimen/dp_80"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BuyCartRadioStyle"/>
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_product_cover"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_80"
        android:layout_marginLeft="@dimen/dp_14"
        android:src="@drawable/ic_default"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toRightOf="@+id/cb_product"
        app:layout_constraintTop_toTopOf="@+id/cb_product"
        app:riv_corner_radius="@dimen/dp_6"/>
    <TextView
        android:id="@+id/tv_product_name"
        android:paddingTop="@dimen/dp_4"
        android:layout_width="@dimen/dp_200"
        android:paddingStart="@dimen/dp_10"
        app:layout_constraintLeft_toRightOf="@+id/img_product_cover"
        app:layout_constraintTop_toTopOf="@+id/img_product_cover"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_spec_name"
        app:layout_constraintLeft_toRightOf="@+id/img_product_cover"
        app:layout_constraintTop_toBottomOf="@+id/tv_product_name"
        style="@style/SpecTvStyle"/>
    <TextView
        android:id="@+id/tv_sale_name"
        android:visibility="visible"
        android:text="@string/tip_not_sale_receiver"
        app:layout_constraintLeft_toRightOf="@+id/img_product_cover"
        app:layout_constraintTop_toBottomOf="@+id/tv_spec_name"
        style="@style/SpecTvStyle"/>
    <TextView
        android:textColor="@color/item_room_tv_price_color"
        android:gravity="center"
        android:id="@+id/tv_spec_price"
        android:layout_height="@dimen/spec_layout_height"
        android:layout_marginTop="@dimen/dp_4"
        android:paddingStart="@dimen/dp_10"
        app:layout_constraintLeft_toLeftOf="@+id/tv_product_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_sale_name"
        style="@style/TvStyle"/>
    <com.chinavisionary.microtang.view.SpecView
        android:id="@+id/spec_view"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spec_layout_height"
        android:layout_marginRight="@dimen/dp_14"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_spec_price"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_spec_number_value"
        android:visibility="gone"
        android:layout_height="@dimen/spec_layout_height"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginRight="@dimen/dp_14"
        android:text="x23"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_sale_name"
        style="@style/TvStyle"/>
    <View
        android:id="@+id/view_bottom_line"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spec_view"
        style="@style/HorizontalLineStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
