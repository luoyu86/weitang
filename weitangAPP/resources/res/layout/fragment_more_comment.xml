<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_search_layout"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        layout="@layout/item_search_layout"/>
    <TextView
        android:id="@+id/tv_product_satisfied"
        android:layout_marginLeft="@dimen/dp_14"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_rent_comment"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include_search_layout"
        style="@style/TitleTvStyle"/>
    <com.hedgehog.ratingbar.RatingBar
        android:gravity="center"
        android:id="@+id/rating_bar_satisfied"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_10"
        app:clickable="false"
        app:layout_constraintLeft_toLeftOf="@+id/tv_product_satisfied"
        app:layout_constraintTop_toBottomOf="@+id/tv_product_satisfied"
        app:starCount="5"
        app:starEmpty="@mipmap/ic_comment_star_normal"
        app:starFill="@mipmap/ic_comment_star_sel"
        app:starHalf="@mipmap/ic_comment_half_star_sel"
        app:starImageHeight="@dimen/dp_16"
        app:starImageWidth="@dimen/dp_16"/>
    <com.hedgehog.ratingbar.RatingBar
        android:gravity="center"
        android:id="@+id/rating_bar_service_satisfied"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_14"
        app:clickable="false"
        app:layout_constraintBottom_toBottomOf="@+id/tv_product_satisfied"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_product_satisfied"
        app:starCount="5"
        app:starEmpty="@mipmap/ic_comment_star_normal"
        app:starFill="@mipmap/ic_comment_star_sel"
        app:starHalf="@mipmap/ic_comment_half_star_sel"
        app:starImageHeight="@dimen/dp_16"
        app:starImageWidth="@dimen/dp_16"/>
    <TextView
        android:id="@+id/tv_product_service_satisfied"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_4"
        android:text="@string/title_service_satisfied"
        app:layout_constraintRight_toLeftOf="@+id/rating_bar_service_satisfied"
        app:layout_constraintTop_toBottomOf="@+id/include_search_layout"
        style="@style/TvStyle"/>
    <View
        android:id="@+id/view_split_line"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rating_bar_satisfied"
        style="@style/HorizontalLineStyle"/>
    <com.chinavisionary.microtang.view.FlowLayout
        android:id="@+id/flow_layout_comment_tag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_14"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_14"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line"/>
    <com.chinavisionary.core.weight.BaseSwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout_more_comment"
        android:paddingLeft="@dimen/dp_14"
        android:paddingRight="@dimen/dp_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flow_layout_comment_tag"/>
</androidx.constraintlayout.widget.ConstraintLayout>
