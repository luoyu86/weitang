<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_266">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dp_5"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginRight="@dimen/dp_5"
        android:layout_marginBottom="@dimen/dp_8"
        app:cardBackgroundColor="@color/color_white"
        app:cardCornerRadius="@dimen/dp_4"
        app:cardElevation="@dimen/dp_4">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.chinavisionary.core.weight.CoreRoundedImageView
                android:id="@+id/img_product_cover"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_146"
                android:scaleType="centerCrop"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:riv_corner_radius_top_left="@dimen/dp_5"
                app:riv_corner_radius_top_right="@dimen/dp_5"/>
            <TextView
                android:textColor="@color/color000000"
                android:ellipsize="end"
                android:id="@+id/tv_product_info"
                android:layout_width="@dimen/dp_0"
                android:layout_marginLeft="@dimen/dp_6"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginRight="@dimen/dp_6"
                android:maxLines="2"
                android:lineSpacingExtra="@dimen/dp_2"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_product_cover"
                style="@style/TvStyle"/>
            <TextView
                android:textSize="@dimen/sp_10"
                android:textColor="@color/color_AAAAAA"
                android:ellipsize="end"
                android:id="@+id/tv_product_sub"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_4"
                android:singleLine="true"
                app:layout_constraintLeft_toLeftOf="@+id/tv_product_info"
                app:layout_constraintRight_toRightOf="@+id/tv_product_info"
                app:layout_constraintTop_toBottomOf="@+id/tv_product_info"
                style="@style/TvStyle"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/colorFE5600"
                android:id="@+id/tv_product_price"
                android:layout_width="wrap_content"
                android:layout_marginBottom="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="@+id/tv_product_info"
                style="@style/TvStyle"/>
            <TextView
                android:textSize="@dimen/sp_11"
                android:textColor="@color/colorCACACA"
                android:id="@+id/tv_product_src_price"
                android:paddingLeft="@dimen/dp_4"
                android:layout_width="wrap_content"
                android:layout_marginBottom="@dimen/dp_2"
                app:layout_constraintBottom_toBottomOf="@+id/tv_product_price"
                app:layout_constraintLeft_toRightOf="@+id/tv_product_price"
                style="@style/TvStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
