<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp_14"
    android:paddingRight="@dimen/dp_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout_content"
        android:background="@drawable/bg_alert"
        android:paddingBottom="@dimen/dp_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color000000"
            android:gravity="center"
            android:id="@+id/tv_publish_time"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:layout_marginLeft="@dimen/dp_18"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/tab_item_select_color"
            android:gravity="center"
            android:id="@+id/tv_right_value"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:layout_marginRight="@dimen/dp_18"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_split_line"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_publish_time"
            style="@style/HorizontalLineStyle"/>
        <TextView
            android:id="@+id/tv_categories_title"
            android:text="@string/title_question_classify"
            app:layout_constraintLeft_toLeftOf="@+id/tv_publish_time"
            app:layout_constraintTop_toBottomOf="@+id/view_split_line"
            style="@style/QuestionClassifyTv"/>
        <TextView
            android:id="@+id/tv_question_title"
            android:text="@string/title_common_question"
            app:layout_constraintLeft_toLeftOf="@+id/tv_publish_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_categories_title"
            style="@style/QuestionClassifyTv"/>
        <TextView
            android:id="@+id/tv_categories_value"
            app:layout_constraintRight_toRightOf="@+id/tv_right_value"
            app:layout_constraintTop_toBottomOf="@+id/view_split_line"
            style="@style/QuestionClassifyValue"/>
        <TextView
            android:id="@+id/tv_question_value"
            app:layout_constraintRight_toRightOf="@+id/tv_right_value"
            app:layout_constraintTop_toBottomOf="@+id/tv_categories_title"
            style="@style/QuestionClassifyValue"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llayout_question"
            android:background="@drawable/bg_question_msg"
            android:padding="@dimen/dp_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_18"
            android:layout_marginTop="@dimen/dp_13"
            android:layout_marginRight="@dimen/dp_18"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_question_title">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/colore757575"
                android:id="@+id/tv_question_info"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hint_title_question_info"
                android:lineSpacingExtra="@dimen/dp_2"
                android:textCursorDrawable="@drawable/edt_cursor_drawable"/>
            <com.lzy.ninegrid.NineGridView
                android:id="@+id/nine_grid_view_commend"
                android:layout_width="@dimen/dp_170"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                app:ngv_singleImageSize="@dimen/dp_50"/>
        </LinearLayout>
        <View
            android:background="@drawable/bg_dotted_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_5"
            android:layerType="software"
            app:layout_constraintTop_toBottomOf="@+id/llayout_question"/>
        <TextView
            android:id="@+id/tv_reply_content"
            android:visibility="gone"
            android:text="微棠社区回复:神神道道多多"
            app:layout_constraintLeft_toLeftOf="@+id/tv_publish_time"
            app:layout_constraintTop_toBottomOf="@+id/llayout_question"
            style="@style/QuestionClassifyTv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
