<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/title_layout"/>
    <com.chinavisionary.core.weight.BaseRecyclerView
        android:id="@+id/recycler_check"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/margin_top_title_height"
        android:layout_marginRight="@dimen/dp_14"
        android:layout_marginBottom="@dimen/dp_86"/>
    <Button
        android:textColor="@color/colore757575"
        android:id="@+id/btn_confirm"
        android:background="@color/colorfafafa"
        android:text="@string/title_submit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/BtnNextStyle"/>
    <CheckBox
        android:textSize="@dimen/sp_15"
        android:textColor="@color/color003cff"
        android:gravity="center_vertical"
        android:id="@+id/cb_agree"
        android:background="@color/color_white"
        android:paddingLeft="@dimen/dp_8"
        android:paddingTop="@dimen/dp_22"
        android:paddingBottom="@dimen/dp_22"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_14"
        android:button="@drawable/bg_cb"
        android:text="@string/title_confirm_check_content"
        app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
        app:layout_constraintLeft_toLeftOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
