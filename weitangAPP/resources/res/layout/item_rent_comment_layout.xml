<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_user_icon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_corner_radius="@dimen/dp_20"
        style="@style/CommendUserIconStyle"/>
    <TextView
        android:textColor="@color/tab_item_select_color"
        android:id="@+id/tv_room_no"
        android:visibility="gone"
        android:text="78-1502"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_room_user_name"
        android:paddingTop="@dimen/dp_4"
        android:layout_marginLeft="@dimen/dp_10"
        app:layout_constraintLeft_toRightOf="@+id/img_user_icon"
        app:layout_constraintTop_toTopOf="@+id/img_user_icon"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_like"
        android:paddingTop="@dimen/dp_4"
        android:layout_marginLeft="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/img_user_icon"
        app:layout_constraintLeft_toRightOf="@+id/img_user_icon"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_room_comment_date"
        android:text="2019-08-21 10:12"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_room_comment_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="评论的内容是。。。。。"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_user_icon"
        style="@style/TvStyle"/>
    <com.lzy.ninegrid.NineGridView
        android:id="@+id/nine_grid_view_commend"
        android:layout_width="@dimen/dp_300"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_room_comment_content"
        app:ngv_singleImageSize="@dimen/dp_70"/>
</androidx.constraintlayout.widget.ConstraintLayout>
