<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_msg"
    android:paddingLeft="@dimen/dp_16"
    android:paddingTop="@dimen/dp_20"
    android:paddingRight="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_14"
    android:layout_marginRight="@dimen/dp_14">
    <ImageView
        android:id="@+id/img_contract_no"
        android:src="@mipmap/ic_contract_no"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ContractRecordIconStyle"/>
    <ImageView
        android:id="@+id/img_contract_time"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@mipmap/ic_contract_time"
        app:layout_constraintLeft_toLeftOf="@+id/img_contract_no"
        app:layout_constraintTop_toBottomOf="@+id/img_contract_no"
        style="@style/ContractRecordIconStyle"/>
    <TextView
        android:id="@+id/tv_contract_no_title"
        android:text="@string/title_contract_no"
        app:layout_constraintLeft_toRightOf="@+id/img_contract_no"
        app:layout_constraintTop_toTopOf="@+id/img_contract_no"
        style="@style/ContractRecordTitleTvStyle"/>
    <TextView
        android:id="@+id/tv_contract_time"
        android:text="@string/title_contract_time"
        app:layout_constraintLeft_toRightOf="@+id/img_contract_time"
        app:layout_constraintTop_toTopOf="@+id/img_contract_time"
        style="@style/ContractRecordTitleTvStyle"/>
    <TextView
        android:textColor="@color/color000000"
        android:id="@+id/tv_contract_no_value"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_contract_no_title"
        style="@style/ContractRecordTitleTvStyle"/>
    <TextView
        android:textColor="@color/color000000"
        android:id="@+id/tv_contract_time_value"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/img_contract_time"
        style="@style/ContractRecordTitleTvStyle"/>
    <Button
        android:textColor="@color/tab_item_select_color"
        android:id="@+id/btn_keep"
        android:background="@drawable/bg_btn_commend"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="0dp"
        android:text="@string/title_keep_rent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_contract_time_value"
        style="@style/CleanCancelBtnStyle"/>
    <Button
        android:id="@+id/btn_exit"
        android:visibility="gone"
        android:text="@string/title_exit_rent"
        app:layout_constraintRight_toLeftOf="@+id/btn_keep"
        app:layout_constraintTop_toTopOf="@+id/btn_keep"
        style="@style/CleanCancelBtnStyle"/>
    <Button
        android:textColor="@color/tab_item_select_color"
        android:id="@+id/btn_wait_pay"
        android:background="@drawable/bg_btn_commend"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="0dp"
        android:text="@string/title_keep_pay"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_contract_time_value"
        style="@style/CleanCancelBtnStyle"/>
    <Button
        android:id="@+id/btn_cancel_pay"
        android:visibility="gone"
        android:text="@string/title_cancel"
        app:layout_constraintRight_toLeftOf="@+id/btn_wait_pay"
        app:layout_constraintTop_toTopOf="@+id/btn_wait_pay"
        style="@style/CleanCancelBtnStyle"/>
    <Button
        android:textColor="@color/tab_item_select_color"
        android:id="@+id/btn_wait_sign_contract"
        android:background="@drawable/bg_btn_commend"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="0dp"
        android:text="@string/title_keep_sign_contract"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_contract_time_value"
        style="@style/CleanCancelBtnStyle"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color686868"
        android:id="@+id/tv_contract_tip"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_contract_time_value"/>
</androidx.constraintlayout.widget.ConstraintLayout>
