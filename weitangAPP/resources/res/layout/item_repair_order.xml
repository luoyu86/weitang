<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_alert"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_8"
    android:layout_marginTop="@dimen/dp_8"
    android:layout_marginRight="@dimen/dp_8">
    <TextView
        android:id="@+id/tv_title"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_repair_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="@+id/tv_title"
        style="@style/ItemRepairOrderValueTv"/>
    <TextView
        android:id="@+id/tv_service_address_title"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_repair_address"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_service_address_value"
        android:text="这个XML文件包括了诸如员工名、部门和社会保险号码之类的信息这个XML文件包括了诸如员工名、部门和社会保险号码之类的信息这个XML文件包括了诸如员工名、部门和社会保险号码之类的信息"
        app:layout_constraintBottom_toBottomOf="@+id/tv_service_address_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_service_address_title"
        app:layout_constraintTop_toTopOf="@+id/tv_service_address_title"
        style="@style/ItemRepairOrderValueTv"/>
    <TextView
        android:id="@+id/tv_service_time_title"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_up_door_time"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_service_address_value"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_service_time_value"
        android:text="@string/title_repair_person"
        app:layout_constraintBottom_toBottomOf="@+id/tv_service_time_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_service_time_title"
        app:layout_constraintTop_toTopOf="@+id/tv_service_time_title"
        style="@style/ItemRepairOrderValueTv"/>
    <TextView
        android:id="@+id/tv_service_person_title"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/title_repair_person"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_service_time_title"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_service_person_value"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/tv_service_person_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_service_person_title"
        app:layout_constraintTop_toTopOf="@+id/tv_service_person_title"
        style="@style/TvStyle"/>
    <View
        android:id="@+id/view_split_line"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_service_person_title"
        app:layout_goneMarginTop="@dimen/dp_12"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_service_state"
        android:layout_height="@dimen/dp_30"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/view_split_line"
        style="@style/TvStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_action"
        android:layout_marginRight="@dimen/dp_12"
        android:text="@string/title_cancel"
        app:layout_constraintBottom_toBottomOf="@+id/tv_service_state"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_service_state"
        style="@style/BtnStoreRadiusStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_contact"
        android:layout_marginRight="@dimen/dp_20"
        android:text="联系师傅"
        app:layout_constraintBottom_toBottomOf="@+id/tv_service_state"
        app:layout_constraintRight_toLeftOf="@+id/btn_action"
        app:layout_constraintTop_toTopOf="@+id/tv_service_state"
        style="@style/BtnStoreGradRadiusStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
