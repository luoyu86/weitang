<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/tv_bg"
        android:background="@color/color_EEEEEE"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_68"/>
    <include layout="@layout/title_layout"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/margin_top_title_height">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/rlayout_content"
                android:background="@drawable/bg_msg"
                android:padding="@dimen/dp_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_12"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginRight="@dimen/dp_12"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_back">
                <com.chinavisionary.core.weight.CoreRoundedImageView
                    android:id="@+id/img_user_icon"
                    android:layout_width="@dimen/dp_35"
                    android:layout_height="@dimen/dp_35"
                    android:src="@drawable/ic_default"
                    android:scaleType="centerCrop"
                    app:riv_corner_radius="@dimen/dp_4"/>
                <TextView
                    android:textSize="@dimen/sp_15"
                    android:textColor="@color/color000000"
                    android:gravity="center"
                    android:id="@+id/tv_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_35"
                    android:layout_marginLeft="@dimen/dp_8"
                    android:text="kchang"
                    android:layout_toRightOf="@+id/img_user_icon"/>
                <CheckBox
                    android:gravity="center_vertical"
                    android:id="@+id/cb_anonymous_commend"
                    android:paddingLeft="@dimen/dp_6"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_35"
                    android:checked="true"
                    android:button="@drawable/bg_cb"
                    android:text="@string/title_anonymous_commend"
                    android:layout_alignParentRight="true"/>
                <com.hedgehog.ratingbar.RatingBar
                    android:gravity="center"
                    android:id="@+id/rating_bar_commend_star"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:layout_marginTop="@dimen/dp_27"
                    android:layout_below="@+id/img_user_icon"
                    android:layout_centerHorizontal="true"
                    app:clickable="true"
                    app:starCount="5"
                    app:starEmpty="@mipmap/ic_comment_star_normal"
                    app:starFill="@mipmap/ic_comment_star_sel"
                    app:starImageHeight="@dimen/dp_26"
                    app:starImageWidth="@dimen/dp_40"/>
                <include
                    android:id="@+id/include_comment_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_24"
                    android:layout_below="@+id/rating_bar_commend_star"
                    layout="@layout/fragment_commend_content"/>
            </RelativeLayout>
            <Button
                android:id="@+id/btn_submit"
                android:layout_marginLeft="@dimen/dp_34"
                android:layout_marginTop="@dimen/dp_30"
                android:layout_marginRight="@dimen/dp_34"
                android:text="@string/title_submit"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rlayout_content"
                style="@style/SubmitBtnStyle"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
