<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.chinavisionary.core.weight.BaseSwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout_main"
        android:background="@color/colorF8F8F8"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/view_bg"
        android:background="@color/color_white"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_top_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/rlayout_title"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_26"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/tv_city"
            android:paddingLeft="@dimen/dp_10"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:maxWidth="@dimen/dp_118"
            android:drawableLeft="@mipmap/ic_project_location"
            android:drawablePadding="@dimen/dp_4"
            style="@style/CityStyle"/>
        <TextView
            android:textColor="@color/color000000"
            android:gravity="center"
            android:id="@+id/edt_input_search"
            android:layout_height="@dimen/dp_28"
            android:layout_marginLeft="@dimen/dp_6"
            android:layout_marginRight="@dimen/dp_0"
            android:hint="@string/hint_input_room"
            android:layout_toLeftOf="@+id/rlayout_server"
            android:layout_toRightOf="@+id/tv_city"
            style="@style/MoreRentRoomSearchEdtStyle"/>
        <RelativeLayout
            android:id="@+id/rlayout_scan"
            android:layout_marginRight="@dimen/dp_11"
            android:layout_alignParentRight="true"
            style="@style/TitleIconLayoutStyle">
            <ImageView
                android:id="@+id/img_title_about"
                android:visibility="visible"
                android:src="@mipmap/ic_scan"
                style="@style/TitleIconStyle"/>
            <TextView
                android:textSize="@dimen/sp_17"
                android:textColor="@color/color_000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_city_value"
                android:paddingRight="@dimen/dp_15"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/title_sz"
                android:singleLine="true"
                android:drawableLeft="@mipmap/ic_city_location"
                android:drawablePadding="@dimen/dp_3"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rlayout_notify"
            android:visibility="visible"
            android:layout_toLeftOf="@+id/rlayout_scan"
            style="@style/TitleIconLayoutStyle">
            <ImageView
                android:id="@+id/img_title_notify"
                android:src="@mipmap/ic_notify"
                style="@style/TitleIconStyle"/>
            <TextView
                android:id="@+id/tv_badge_value"
                android:visibility="gone"
                android:layout_marginTop="-4dp"
                android:layout_marginRight="-3dp"
                android:layout_alignTop="@+id/img_title_notify"
                android:layout_alignRight="@+id/img_title_notify"
                style="@style/TvBadgeStyle"/>
            <TextView
                android:id="@+id/tv_badge_paint"
                android:visibility="gone"
                android:layout_marginRight="-2dp"
                android:layout_alignTop="@+id/img_title_notify"
                android:layout_alignRight="@+id/img_title_notify"
                style="@style/TvPaintStyle"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rlayout_server"
            android:visibility="visible"
            android:layout_toLeftOf="@+id/rlayout_notify"
            style="@style/TitleIconLayoutStyle">
            <ImageView
                android:id="@+id/img_title_server"
                android:src="@mipmap/ic_server"
                style="@style/TitleIconStyle"/>
        </RelativeLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
