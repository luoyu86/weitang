<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/spec_layout_height">
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/img_btn_reduce"
        android:src="@mipmap/ic_spec_reduce"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SpecImgBtnStyle"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:gravity="center"
        android:id="@+id/tv_spec_number"
        android:background="@color/color_bg"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:text="1"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintLeft_toRightOf="@+id/img_btn_reduce"
        app:layout_constraintTop_toTopOf="@+id/img_btn_reduce"
        style="@style/SpecImgBtnStyle"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/img_btn_add"
        android:src="@mipmap/ic_spec_add"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintLeft_toRightOf="@+id/tv_spec_number"
        app:layout_constraintTop_toTopOf="@+id/img_btn_reduce"
        style="@style/SpecImgBtnStyle"/>
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_add_spec"
        android:background="@drawable/bg_btn_radius_15"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginRight="@dimen/dp_20"
        android:src="@mipmap/ic_add_white"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
