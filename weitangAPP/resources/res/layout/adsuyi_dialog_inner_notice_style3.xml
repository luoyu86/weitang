<?xml version="1.0" encoding="utf-8"?>
<cn.admobiletop.adsuyi.ad.widget.notice.ADSuyiNoticeAdContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adsuyi_notice_ad_container"
    android:background="@drawable/adsuyi_shape_fafbfc_radius8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="12dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="20dp"
    android:layout_centerHorizontal="true"
    android:elevation="10dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/adsuyi_click_container"
        android:paddingLeft="16dp"
        android:paddingTop="13dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="#999999"
                android:ellipsize="end"
                android:id="@+id/adsuyi_tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:text="满足优质的流量市场，为不同意向客户提供针满足优质的流量市场。"
                android:maxLines="1"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/adsuyi_iv_target"
                android:layout_width="37dp"
                android:layout_height="14dp"/>
        </LinearLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp">
            <cn.admobiletop.adsuyi.ad.widget.roundimage.RoundedImageView
                android:id="@+id/adsuyi_iv_image"
                android:layout_width="88dp"
                android:layout_height="50dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#3c3c3c"
                android:ellipsize="end"
                android:id="@+id/adsuyi_tv_des"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                android:text="满足优质的流量市场，为不同意向客户提供针满足优质的流量市场。"
                android:maxLines="2"
                android:layout_toRightOf="@+id/adsuyi_iv_image"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#2196f3"
                android:id="@+id/adsuyi_tv_action_button"
                android:background="@drawable/adsuyi_shape_action_button_border_radius6"
                android:paddingLeft="5dp"
                android:paddingTop="2dp"
                android:paddingRight="5dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="行动按钮"
                android:layout_alignBottom="@+id/adsuyi_iv_image"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/adsuyi_iv_close"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/adsuyi_icon_rec_round_close"
                android:layout_alignBottom="@+id/adsuyi_iv_image"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
    </LinearLayout>
</cn.admobiletop.adsuyi.ad.widget.notice.ADSuyiNoticeAdContainer>
