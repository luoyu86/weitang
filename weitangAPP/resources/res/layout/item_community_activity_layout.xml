<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_12"
    android:layout_marginRight="@dimen/dp_12"
    android:layout_marginBottom="@dimen/dp_16">
    <View
        android:id="@+id/view_bg"
        android:background="@drawable/bg_community_item"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_location"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_activity_cover"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_12"
        android:src="@drawable/ic_default"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="1:0.44"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_activity_timer"
        app:riv_corner_radius="@dimen/dp_10"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_white"
        android:id="@+id/tv_activity_lab"
        android:background="@drawable/bg_community_tag"
        android:paddingLeft="@dimen/dp_8"
        android:paddingTop="@dimen/dp_2"
        android:paddingRight="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_2"
        android:layout_marginLeft="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_activity_title"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:ellipsize="end"
        android:id="@+id/tv_activity_title"
        android:paddingRight="@dimen/dp_20"
        android:layout_width="@dimen/dp_0"
        android:layout_marginLeft="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_15"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/tv_activity_lab"
        app:layout_constraintRight_toLeftOf="@+id/tv_activity_state"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_AAAAAA"
        android:id="@+id/tv_activity_time"
        android:layout_marginTop="@dimen/dp_10"
        android:drawableLeft="@mipmap/ic_activity_time_start"
        android:drawablePadding="@dimen/dp_4"
        app:layout_constraintLeft_toLeftOf="@+id/tv_activity_lab"
        app:layout_constraintTop_toBottomOf="@+id/tv_activity_title"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color080808"
        android:ellipsize="end"
        android:id="@+id/tv_activity_location"
        android:paddingRight="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_16"
        android:layout_width="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_10"
        android:maxLines="2"
        android:drawableLeft="@mipmap/ic_activity_location_available"
        android:drawablePadding="@dimen/dp_4"
        app:layout_constraintLeft_toLeftOf="@+id/img_activity_cover"
        app:layout_constraintRight_toLeftOf="@+id/tv_activity_distance"
        app:layout_constraintTop_toBottomOf="@+id/img_activity_cover"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_AAAAAA"
        android:gravity="right"
        android:id="@+id/tv_activity_distance"
        android:paddingTop="@dimen/dp_2"
        android:layout_width="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/tv_activity_location"
        app:layout_constraintRight_toRightOf="@+id/img_activity_cover"
        app:layout_constraintTop_toTopOf="@+id/tv_activity_location"
        style="@style/TvStyle"/>
    <TextView
        android:textColor="@color/color555555"
        android:id="@+id/tv_activity_publisher"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dp_6"
        app:layout_constraintLeft_toLeftOf="@+id/tv_activity_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_activity_time"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/colorFE9900"
        android:gravity="right"
        android:id="@+id/tv_activity_join_number"
        android:visibility="gone"
        android:layout_width="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_activity_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_activity_title"
        style="@style/TvStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_white"
        android:id="@+id/btn_activity_join"
        android:background="@drawable/bg_btn_activity_join"
        android:visibility="gone"
        android:layout_width="@dimen/dp_60"
        android:layout_height="@dimen/dp_24"
        android:text="@string/title_go_join"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_publisher"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:id="@+id/view_split_line"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dp_18"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_activity_join"
        style="@style/HorizontalLineStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/colorFE9900"
        android:id="@+id/tv_activity_timer"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/title_activity_apply_end"
        app:layout_constraintLeft_toLeftOf="@+id/tv_activity_lab"
        app:layout_constraintTop_toBottomOf="@+id/tv_activity_time"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_activity_timer_day_value"
        android:paddingLeft="@dimen/dp_2"
        android:paddingRight="@dimen/dp_2"
        android:layout_width="wrap_content"
        android:layout_marginLeft="@dimen/dp_4"
        android:minWidth="@dimen/dp_18"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_timer"
        app:layout_constraintLeft_toRightOf="@+id/tv_activity_timer"
        style="@style/TimerTvStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/colorFE9900"
        android:id="@+id/tv_activity_timer_day_title"
        android:layout_marginLeft="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/title_day"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_timer"
        app:layout_constraintLeft_toRightOf="@+id/tv_activity_timer_day_value"
        style="@style/TvStyle"/>
    <TextView
        android:id="@+id/tv_activity_timer_hour_value"
        android:layout_marginLeft="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_timer"
        app:layout_constraintLeft_toRightOf="@+id/tv_activity_timer_day_title"
        style="@style/TimerTvStyle"/>
    <TextView
        android:id="@+id/tv_activity_timer_min_value"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_timer"
        app:layout_constraintLeft_toRightOf="@+id/tv_time_split"
        style="@style/TimerTvStyle"/>
    <TextView
        android:id="@+id/tv_time_split"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_timer_hour_value"
        app:layout_constraintLeft_toRightOf="@+id/tv_activity_timer_hour_value"
        app:layout_constraintTop_toTopOf="@+id/tv_activity_timer_hour_value"
        style="@style/TimerSplitTvStyle"/>
    <TextView
        android:id="@+id/tv_time_split_end"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_timer_hour_value"
        app:layout_constraintLeft_toRightOf="@+id/tv_activity_timer_min_value"
        app:layout_constraintTop_toTopOf="@+id/tv_activity_timer_hour_value"
        style="@style/TimerSplitTvStyle"/>
    <TextView
        android:id="@+id/tv_activity_timer_second_value"
        app:layout_constraintBottom_toBottomOf="@+id/tv_activity_timer"
        app:layout_constraintLeft_toRightOf="@+id/tv_time_split_end"
        style="@style/TimerTvStyle"/>
    <TextView
        android:id="@+id/tv_activity_state"
        app:layout_constraintRight_toRightOf="@+id/view_bg"
        app:layout_constraintTop_toTopOf="@+id/tv_activity_title"
        style="@style/ActivityTimerTvStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
