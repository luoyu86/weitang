<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/base_66_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_update_door_top_left_right_radius_5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_220">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_title"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="@dimen/dp_180"
            android:layout_height="@dimen/dp_48"
            android:text="@string/title_setup_door_pwd"
            android:maxLines="1"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/img_close"
            android:padding="@dimen/dp_14"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_48"
            android:src="@mipmap/ic_del_grad"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rlayout_bottom"
            android:background="@drawable/bg_fund_white_radius_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_15"
            android:layout_marginRight="@dimen/dp_15"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">
            <TextView
                android:id="@+id/tv_bg"
                android:layout_height="@dimen/dp_1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/BottomTitleBgTvStyle"/>
            <View
                android:id="@+id/view_top_split_line"
                android:visibility="gone"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                app:layout_constraintLeft_toLeftOf="parent"
                style="@style/HorizontalLineStyle"/>
            <View
                android:id="@+id/view_split_line"
                android:background="@color/colorF8F8F8"
                android:visibility="gone"
                android:layout_height="@dimen/dp_10"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edt_new_again_pwd"
                style="@style/HorizontalLineStyle"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_user_name"
                android:layout_height="@dimen/dp_50"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_bg"
                style="@style/UpdatePwdEdtStyle"/>
            <TextView
                android:gravity="center"
                android:id="@+id/edt_phone"
                android:layout_height="@dimen/dp_50"
                android:text="13316429965"
                android:inputType="phone"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_user_name"
                style="@style/UpdatePwdEdtStyle"/>
            <EditText
                android:id="@+id/edt_sms_code"
                android:focusable="true"
                android:layout_height="@dimen/dp_50"
                android:hint="@string/hint_title_input_sms_code"
                android:maxLength="6"
                android:inputType="number"
                android:imeOptions="actionNext"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edt_phone"
                style="@style/UpdatePwdEdtStyle"/>
            <EditText
                android:id="@+id/edt_pwd"
                android:visibility="gone"
                android:hint="@string/hint_title_input_now_pwd"
                android:maxLength="16"
                android:inputType="text"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edt_sms_code"
                style="@style/UpdatePwdEdtStyle"/>
            <EditText
                android:id="@+id/edt_again_pwd"
                android:layout_height="@dimen/dp_50"
                android:hint="@string/hint_title_input_number_pwd"
                android:maxLength="6"
                android:inputType="numberPassword"
                android:imeOptions="actionNext"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edt_pwd"
                style="@style/UpdatePwdEdtStyle"/>
            <ImageView
                android:id="@+id/img_open_pwd"
                android:padding="@dimen/dp_8"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:src="@mipmap/ic_pwd_close"
                app:layout_constraintBottom_toBottomOf="@+id/edt_again_pwd"
                app:layout_constraintRight_toRightOf="@+id/edt_again_pwd"
                app:layout_constraintTop_toTopOf="@+id/edt_again_pwd"/>
            <EditText
                android:id="@+id/edt_new_again_pwd"
                android:layout_height="@dimen/dp_50"
                android:hint="@string/hint_title_input_again_number_pwd"
                android:maxLength="6"
                android:inputType="numberPassword"
                android:imeOptions="actionDone"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edt_again_pwd"
                style="@style/UpdatePwdEdtStyle"/>
            <ImageView
                android:id="@+id/img_open_again_pwd"
                android:padding="@dimen/dp_8"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:src="@mipmap/ic_pwd_close"
                app:layout_constraintBottom_toBottomOf="@+id/edt_new_again_pwd"
                app:layout_constraintRight_toRightOf="@+id/edt_new_again_pwd"
                app:layout_constraintTop_toTopOf="@+id/edt_new_again_pwd"/>
            <ImageView
                android:id="@+id/img_phone"
                android:visibility="gone"
                android:layout_width="@dimen/dp_17"
                android:layout_height="@dimen/dp_25"
                android:layout_marginLeft="@dimen/dp_20"
                android:src="@mipmap/ic_phone"
                app:layout_constraintBottom_toBottomOf="@+id/edt_phone"
                app:layout_constraintLeft_toLeftOf="@+id/edt_phone"
                app:layout_constraintTop_toTopOf="@+id/edt_phone"/>
            <ImageView
                android:id="@+id/img_sms_code"
                android:visibility="gone"
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_21"
                android:layout_marginLeft="@dimen/dp_20"
                android:src="@mipmap/ic_sms_code"
                app:layout_constraintBottom_toBottomOf="@+id/edt_sms_code"
                app:layout_constraintLeft_toLeftOf="@+id/edt_sms_code"
                app:layout_constraintTop_toTopOf="@+id/edt_sms_code"/>
            <ImageView
                android:id="@+id/img_pwd"
                android:visibility="gone"
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_21"
                android:layout_marginLeft="@dimen/dp_20"
                android:src="@mipmap/ic_pwd"
                app:layout_constraintBottom_toBottomOf="@+id/edt_pwd"
                app:layout_constraintLeft_toLeftOf="@+id/edt_pwd"
                app:layout_constraintTop_toTopOf="@+id/edt_pwd"/>
            <ImageView
                android:id="@+id/img_again_pwd"
                android:visibility="gone"
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_21"
                android:layout_marginLeft="@dimen/dp_20"
                android:src="@mipmap/ic_pwd"
                app:layout_constraintBottom_toBottomOf="@+id/edt_again_pwd"
                app:layout_constraintLeft_toLeftOf="@+id/edt_again_pwd"
                app:layout_constraintTop_toTopOf="@+id/edt_again_pwd"/>
            <ImageView
                android:id="@+id/img_new_again_pwd"
                android:visibility="gone"
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_21"
                android:layout_marginLeft="@dimen/dp_20"
                android:src="@mipmap/ic_pwd"
                app:layout_constraintBottom_toBottomOf="@+id/edt_new_again_pwd"
                app:layout_constraintLeft_toLeftOf="@+id/edt_new_again_pwd"
                app:layout_constraintTop_toTopOf="@+id/edt_new_again_pwd"/>
            <TextView
                android:id="@+id/tv_show_pwd"
                android:visibility="gone"
                android:text="@string/title_show"
                app:layout_constraintRight_toRightOf="@+id/edt_pwd"
                app:layout_constraintTop_toTopOf="@+id/edt_pwd"
                style="@style/LoginTipTvStyle"/>
            <TextView
                android:id="@+id/tv_show_again_pwd"
                android:visibility="gone"
                android:text="@string/title_show"
                app:layout_constraintRight_toRightOf="@+id/edt_again_pwd"
                app:layout_constraintTop_toTopOf="@+id/edt_again_pwd"
                style="@style/LoginTipTvStyle"/>
            <TextView
                android:id="@+id/tv_show_new_again_pwd"
                android:visibility="gone"
                android:text="@string/title_show"
                app:layout_constraintRight_toRightOf="@+id/edt_new_again_pwd"
                app:layout_constraintTop_toTopOf="@+id/edt_new_again_pwd"
                style="@style/LoginTipTvStyle"/>
            <Button
                android:id="@+id/btn_send_sms"
                android:background="@null"
                android:text="@string/title_send_sms_code"
                app:layout_constraintBottom_toBottomOf="@+id/edt_phone"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/edt_phone"
                style="@style/LoginSendSmsBtnStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textColor="@color/colorFE9900"
            android:gravity="center"
            android:id="@+id/tv_forget_pwd"
            android:visibility="gone"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_40"
            android:layout_marginLeft="@dimen/dp_16"
            android:text="@string/title_forget_pwd"
            app:layout_constraintRight_toRightOf="@+id/rlayout_bottom"
            app:layout_constraintTop_toBottomOf="@+id/rlayout_bottom"
            style="@style/BottomTitleTvStyle"/>
        <TextView
            android:textColor="@color/colorFE9900"
            android:id="@+id/tv_number_pwd_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_16"
            android:text="提示：门锁密码必须为6位数字"
            app:layout_constraintRight_toRightOf="@+id/rlayout_bottom"
            app:layout_constraintTop_toBottomOf="@+id/rlayout_bottom"
            style="@style/BottomTitleTvStyle"/>
        <View
            android:id="@+id/view_bottom_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            style="@style/BottomViewBgStyle"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tv_confirm"
            android:layout_marginBottom="16dp"
            android:text="@string/title_confirm_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            style="@style/BottomBtnStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
