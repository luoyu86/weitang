<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_id_card_auth_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:text="@string/title_id_card_auth"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RoomDetailsMainTitleTvStyle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout_id_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_id_card_auth_title">
        <include
            android:id="@+id/item_id_card_type_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/item_right_layout"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llayout_id_card"
            android:paddingLeft="@dimen/dp_14"
            android:paddingRight="@dimen/dp_14"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_100"
            android:layout_marginTop="@dimen/dp_22"
            android:weightSum="2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/item_id_card_type_layout">
            <com.chinavisionary.core.weight.CoreRoundedImageView
                android:id="@+id/img_id_face"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@mipmap/ic_id_card_face"
                android:layout_weight="1"/>
            <TextView
                android:layout_width="@dimen/dp_16"
                android:layout_height="match_parent"/>
            <com.chinavisionary.core.weight.CoreRoundedImageView
                android:id="@+id/img_id_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@mipmap/ic_id_card_back"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dp_15"
            android:gravity="center"
            android:id="@+id/tv_id_card_face_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_15"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginRight="@dimen/dp_20"
            android:text="@string/title_id_card_face"
            android:includeFontPadding="false"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tv_id_card_back_title"
            app:layout_constraintTop_toBottomOf="@+id/llayout_id_card"
            app:layout_constraintVertical_chainStyle="spread"/>
        <TextView
            android:textSize="@dimen/dp_15"
            android:gravity="center"
            android:id="@+id/tv_id_card_back_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_15"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginRight="@dimen/dp_12"
            android:text="@string/title_id_card_back"
            android:includeFontPadding="false"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@+id/tv_id_card_face_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llayout_id_card"
            app:layout_constraintVertical_chainStyle="spread"/>
        <com.chinavisionary.core.weight.CoreRoundedImageView
            android:id="@+id/img_bg_auth"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_105"
            android:layout_marginLeft="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_28"
            android:layout_marginRight="@dimen/dp_14"
            android:src="@mipmap/ic_bg_auth"
            android:scaleType="centerCrop"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_id_card_back_title"/>
        <com.chinavisionary.core.weight.CoreRoundedImageView
            android:id="@+id/img_user_face"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"
            android:layout_marginLeft="@dimen/dp_30"
            android:src="@mipmap/ic_face"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/img_bg_auth"
            app:layout_constraintLeft_toLeftOf="@+id/img_bg_auth"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color383838"
            android:id="@+id/tv_tip_auth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_26"
            android:text="@string/title_unauth"
            app:layout_constraintLeft_toRightOf="@+id/img_user_face"
            app:layout_constraintTop_toTopOf="@+id/img_bg_auth"/>
        <Button
            android:textSize="@dimen/sp_15"
            android:textColor="@color/color_white"
            android:id="@+id/btn_action_auth"
            android:background="@drawable/bg_btn_auth"
            android:layout_width="@dimen/dp_110"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/title_auth"
            app:layout_constraintLeft_toLeftOf="@+id/tv_tip_auth"
            app:layout_constraintTop_toBottomOf="@+id/tv_tip_auth"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
