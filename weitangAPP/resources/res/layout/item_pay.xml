<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_title"
        android:layout_height="@dimen/dp_51"
        android:text="@string/title_confirm_pay"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RoomDetailsMainTitleTvStyle"/>
    <View
        android:id="@+id/view_title_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/HorizontalLineStyle"/>
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_pay_icon"
        android:src="@mipmap/ic_pay_alipay"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_title_line"
        style="@style/PayIconImgStyle"/>
    <TextView
        android:id="@+id/tv_left_title"
        android:text="@string/title_alipay"
        app:layout_constraintLeft_toRightOf="@+id/img_pay_icon"
        app:layout_constraintTop_toBottomOf="@+id/view_title_line"
        style="@style/PayTitleTvStyle"/>
    <CheckBox
        android:enabled="false"
        android:id="@+id/cb_pay"
        android:background="@null"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_52"
        android:layout_marginRight="@dimen/dp_14"
        android:checked="true"
        android:button="@drawable/bg_cb"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_title_line"/>
    <TextView
        android:id="@+id/tv_split_line"
        android:background="@color/color_EEEEEE"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintTop_toBottomOf="@+id/img_pay_icon"/>
    <TextView
        android:id="@+id/tv_item"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_58"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_title_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
