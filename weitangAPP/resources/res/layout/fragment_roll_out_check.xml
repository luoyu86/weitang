<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_bg"
        android:background="@color/base_66_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout_roll_out"
        android:background="@color/color_white"
        android:paddingLeft="@dimen/dp_14"
        android:paddingRight="@dimen/dp_14"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_234"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <androidx.appcompat.widget.AppCompatEditText
            android:enabled="false"
            android:id="@+id/edt_account_phone"
            android:maxLines="1"
            android:maxLength="11"
            android:inputType="phone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/RollOutEdtStyle"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/tab_item_select_color"
            android:id="@+id/btn_send_sms"
            android:background="@drawable/bg_btn_sms_code"
            android:text="@string/title_send_sms_code"
            app:layout_constraintBottom_toBottomOf="@+id/edt_account_phone"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/edt_account_phone"
            style="@style/LoginSendSmsBtnStyle"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edt_sms_code"
            android:hint="@string/hint_input_sms_code"
            android:maxLines="1"
            android:maxLength="6"
            android:inputType="number"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edt_account_phone"
            style="@style/RollOutEdtStyle"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_alipay_account"
            android:layout_height="@dimen/dp_50"
            android:text="@string/placeholder_alipay_account"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edt_sms_code"
            style="@style/TvStyle"/>
        <View
            android:id="@+id/view_split_line"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_alipay_account"
            style="@style/HorizontalLineStyle"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_alipay_real_name"
            android:layout_height="@dimen/dp_50"
            android:text="@string/placeholder_alipay_account_name"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_split_line"
            style="@style/TvStyle"/>
        <View
            android:id="@+id/view_split_line_bottom"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_alipay_real_name"
            style="@style/HorizontalLineStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_title_roll_out_price"
        android:background="@color/color_bg"
        android:paddingLeft="@dimen/dp_14"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:text="@string/placeholder_roll_out_price"
        app:layout_constraintBottom_toTopOf="@+id/constraint_layout_roll_out"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/TitleTvStyle"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/sp_14"
        android:textColor="@color/tab_item_select_color"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:background="@null"
        android:paddingRight="@dimen/dp_14"
        android:layout_width="@dimen/dp_90"
        android:layout_height="@dimen/dp_48"
        android:text="@string/title_confirm"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title_roll_out_price"/>
</androidx.constraintlayout.widget.ConstraintLayout>
