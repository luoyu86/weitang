<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/title_layout"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/margin_top_title_height"
        app:layout_constraintBottom_toTopOf="@+id/btn_next"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tv_activity_title"
                    android:paddingLeft="@dimen/dp_14"
                    android:paddingTop="@dimen/dp_15"
                    android:paddingRight="@dimen/dp_14"
                    android:paddingBottom="@dimen/dp_15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TvStyle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llayout_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_activity_title"/>
                <View
                    android:id="@+id/view_bottom_split_line"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llayout_score"
                    style="@style/HorizontalLineStyle"/>
                <TextView
                    android:id="@+id/tv_comment_title"
                    android:paddingTop="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_6"
                    android:visibility="gone"
                    android:layout_marginLeft="@dimen/dp_14"
                    android:text="@string/title_comment_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llayout_score"
                    style="@style/CommentTvStyle"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/sp_14"
                    android:textColorHint="@color/colorB4B4B4"
                    android:id="@+id/edt_comment_content"
                    android:padding="@dimen/dp_15"
                    android:hint="@string/hint_activity_comment"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_comment_title"
                    style="@style/EdtCommentStyle"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color999999"
                    android:id="@+id/tv_input_max_length_tip"
                    android:padding="@dimen/dp_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/placeholder_max_length"
                    app:layout_constraintBottom_toBottomOf="@+id/edt_comment_content"
                    app:layout_constraintRight_toRightOf="@+id/edt_comment_content"/>
                <TextView
                    android:id="@+id/tv_add_pic_title"
                    android:layout_marginLeft="@dimen/dp_14"
                    android:layout_marginTop="@dimen/dp_20"
                    android:text="@string/title_comment_image"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edt_comment_content"
                    style="@style/CommentTvStyle"/>
                <FrameLayout
                    android:id="@+id/flayout_nine_grid_view"
                    android:layout_width="@dimen/dp_234"
                    android:layout_height="@dimen/dp_234"
                    android:layout_marginLeft="@dimen/dp_14"
                    android:layout_marginTop="@dimen/dp_13"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_add_pic_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next"
        android:visibility="visible"
        android:text="@string/title_submit_comment"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/BtnNextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
