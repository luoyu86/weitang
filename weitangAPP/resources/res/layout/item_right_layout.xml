<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_48">
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/color383838"
        android:gravity="center_vertical"
        android:id="@+id/tv_left_title"
        android:paddingLeft="@dimen/dp_14"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/title_card_type"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/colore757575"
        android:gravity="center_vertical"
        android:id="@+id/tv_right_title"
        android:paddingRight="@dimen/dp_14"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="身份证"
        app:layout_constraintRight_toLeftOf="@+id/img_right_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <ImageView
        android:id="@+id/img_right_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_14"
        android:src="@mipmap/ic_right_direction"
        app:layout_constraintBottom_toBottomOf="@+id/tv_left_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_left_title"/>
    <TextView
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_left_title"
        style="@style/HorizontalLineStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
