<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_bg"
        android:layout_width="@dimen/dp_272"
        android:layout_height="@dimen/dp_346"
        android:src="@mipmap/ic_rent_confirm_alert_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_close"
        android:padding="@dimen/dp_8"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:src="@mipmap/ic_del_whiter"
        app:layout_constraintRight_toRightOf="@+id/img_bg"
        app:layout_constraintTop_toTopOf="@+id/img_bg"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="#535353"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_title"
        android:paddingTop="@dimen/dp_20"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:text="@string/big_tip_msg"
        app:layout_constraintBottom_toBottomOf="@+id/img_bg"
        app:layout_constraintLeft_toLeftOf="@+id/img_bg"
        app:layout_constraintRight_toRightOf="@+id/img_bg"
        app:layout_constraintTop_toTopOf="@+id/img_bg"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="#555"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:paddingLeft="@dimen/dp_10"
        android:paddingTop="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
        app:layout_constraintLeft_toLeftOf="@+id/img_bg"
        app:layout_constraintRight_toRightOf="@+id/img_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TvStyle"/>
    <Button
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:background="@drawable/bg_alert_asset_confirm"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_42"
        android:layout_marginLeft="@dimen/dp_25"
        android:layout_marginRight="@dimen/dp_25"
        android:layout_marginBottom="@dimen/dp_14"
        android:text="@string/title_go_confirm"
        app:layout_constraintBottom_toBottomOf="@+id/img_bg"
        app:layout_constraintLeft_toLeftOf="@+id/img_bg"
        app:layout_constraintRight_toRightOf="@+id/img_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
