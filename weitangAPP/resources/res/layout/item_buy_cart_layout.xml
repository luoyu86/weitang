<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cb_business"
        android:layout_height="@dimen/dp_30"
        android:checked="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BuyCartRadioStyle"/>
    <com.chinavisionary.core.weight.CoreRoundedImageView
        android:id="@+id/img_business_cover"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:layout_marginLeft="@dimen/dp_14"
        android:src="@drawable/ic_default"
        android:scaleType="centerCrop"
        app:layout_constraintLeft_toRightOf="@+id/cb_business"
        app:layout_constraintTop_toTopOf="@+id/cb_business"
        app:riv_corner_radius="@dimen/dp_15"/>
    <TextView
        android:id="@+id/tv_business_name"
        android:paddingStart="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/img_business_cover"
        app:layout_constraintLeft_toRightOf="@+id/img_business_cover"
        app:layout_constraintTop_toTopOf="@+id/img_business_cover"
        style="@style/TvStyle"/>
    <com.chinavisionary.microtang.view.CustomTextView
        android:textColor="@color/tab_item_select_color"
        android:id="@+id/tv_order_state_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/img_business_cover"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/img_business_cover"
        style="@style/TvStyle"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:id="@+id/tv_self_picked_address"
        android:background="@null"
        android:paddingRight="@dimen/dp_12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/dp_14"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_14"
        app:layout_constraintLeft_toLeftOf="@+id/img_business_cover"
        app:layout_constraintTop_toBottomOf="@+id/img_business_cover"
        style="@style/SpecTvStyle"/>
    <View
        android:id="@+id/view_top_line"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_self_picked_address"
        style="@style/HorizontalLineStyle"/>
    <com.chinavisionary.microtang.view.BuyCartSpecView
        android:id="@+id/buy_cart_spec_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_top_line"/>
    <View
        android:id="@+id/view_bottom_one_line"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buy_cart_spec_view"
        style="@style/HorizontalLineStyle"/>
    <View
        android:id="@+id/view_bottom_line"
        android:layout_height="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buy_cart_spec_view"
        style="@style/HorizontalLineStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
