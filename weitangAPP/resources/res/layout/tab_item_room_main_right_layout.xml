<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_tab_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/img_tab_bg_tip"
        android:background="@color/color9A9A9A"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/img_tab_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_4"
        android:src="@mipmap/ic_tab_select_text_bg"
        app:layout_constraintBottom_toBottomOf="@+id/tv_tab_title"
        app:layout_constraintRight_toRightOf="@+id/tv_tab_title"/>
    <ImageView
        android:id="@+id/img_tab_icon_right"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/ic_tab_select_text_bg"
        android:rotation="180"
        app:layout_constraintLeft_toLeftOf="@+id/tv_tab_title"
        app:layout_constraintTop_toTopOf="@+id/tv_tab_title"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/color262626"
        android:gravity="left"
        android:id="@+id/tv_tab_title"
        android:layout_marginLeft="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
