<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.chinavisionary.core.weight.BaseSwipeRefreshLayout
        android:id="@+id/recycler_comment"
        android:background="@color/colorF8F8F8"
        android:paddingTop="@dimen/dp_4"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:id="@+id/tv_rent_change_info"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/dp_20"
        android:text="@string/title_cat_rent_change_info"
        android:drawableRight="@mipmap/ic_go_auth_right_arrow"
        android:drawablePadding="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/TvStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
