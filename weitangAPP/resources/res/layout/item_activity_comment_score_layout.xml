<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tv_product_service_satisfied"
        android:layout_width="@dimen/dp_100"
        android:layout_height="@dimen/dp_40"
        android:layout_marginLeft="@dimen/dp_14"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <com.hedgehog.ratingbar.RatingBar
        android:gravity="center"
        android:id="@+id/rating_bar_service_satisfied"
        android:paddingLeft="@dimen/dp_14"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        app:clickable="true"
        app:layout_constraintLeft_toRightOf="@+id/tv_product_service_satisfied"
        app:layout_constraintTop_toTopOf="@+id/tv_product_service_satisfied"
        app:starCount="5"
        app:starEmpty="@mipmap/ic_activity_comment_normal"
        app:starFill="@mipmap/ic_activity_comment_good"
        app:starHalf="@mipmap/ic_activity_comment_good"
        app:starImageHeight="@dimen/dp_35"
        app:starImagePadding="@dimen/dp_10"
        app:starImageWidth="@dimen/dp_35"/>
    <TextView
        android:textColor="@color/color555555"
        android:gravity="center"
        android:id="@+id/tv_tip_commend_level"
        android:paddingRight="@dimen/dp_14"
        android:visibility="gone"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_40"
        app:layout_constraintBottom_toBottomOf="@+id/tv_product_service_satisfied"
        app:layout_constraintLeft_toRightOf="@+id/rating_bar_service_satisfied"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_product_service_satisfied"
        style="@style/TvStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
