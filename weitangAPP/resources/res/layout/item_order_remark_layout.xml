<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_48">
    <com.chinavisionary.microtang.view.CustomTextView
        android:textColor="@color/colore757575"
        android:gravity="center"
        android:id="@+id/tv_left_title"
        android:paddingLeft="@dimen/dp_12"
        android:layout_height="match_parent"
        android:text="@string/title_remark"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TvStyle"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textColorHint="@color/colore757575"
        android:gravity="center"
        android:id="@+id/edt_input_remark"
        android:background="@drawable/bg_btn_store_eee_4_radius"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_4"
        android:layout_width="@dimen/dp_260"
        android:layout_height="@dimen/dp_34"
        android:layout_marginRight="@dimen/dp_12"
        android:hint="@string/hint_edt_input_remark"
        android:maxLength="20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BaseEditTextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
