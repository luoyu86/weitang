<?xml version="1.0" encoding="utf-8"?>
<com.tianmu.checkapk.widget.NoticeAdContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/tianmu_nir_notice_ad_container"
    android:background="@drawable/tianmu_shape_ffffffff_radius12"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_margin="10dp">
    <com.tianmu.biz.widget.roundimage.RoundImageView
        android:id="@+id/tianmu_nir_iv_cover"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginLeft="15dp"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#555555"
        android:id="@+id/tianmu_nir_tv_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="15dp"
        android:text="@string/tianmu_app_not_installed"
        android:layout_toRightOf="@+id/tianmu_nir_iv_cover"
        android:layout_alignTop="@+id/tianmu_nir_iv_cover"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#808080"
        android:id="@+id/tianmu_nir_tv_do_not_remind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/tianmu_app_do_not_remind"
        android:layout_alignLeft="@+id/tianmu_nir_tv_tips"
        android:layout_alignBottom="@+id/tianmu_nir_iv_cover"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#0091ff"
        android:id="@+id/tianmu_nir_tv_install_now"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:text="@string/tianmu_app_install_now"
        android:layout_toRightOf="@+id/tianmu_nir_tv_do_not_remind"
        android:layout_alignBottom="@+id/tianmu_nir_tv_do_not_remind"/>
    <ImageView
        android:id="@+id/tianmu_iv_close"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginRight="15dp"
        android:src="@drawable/tianmu_icon_rec_round_close"
        android:scaleType="centerCrop"
        android:layout_alignTop="@+id/tianmu_nir_iv_cover"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:src="@drawable/tianmu_icon_platform_icon"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</com.tianmu.checkapk.widget.NoticeAdContainer>
